generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CustomerUser {
  id                String                 @id @default(uuid())
  email             String                 @unique
  picture           String?
  name              String
  password          String?
  authSource        AuthSource             @default(self)
  type              CustomerType           @default(user)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  gender            String?
  isActive          Boolean                @default(true)
  isEmailVerified   Boolean                @default(false)
  isPhoneVerified   Boolean                @default(false)
  lastLoginAt       DateTime?
  phoneNumber       String?                @unique
  addresses         Address[]
  cartItems         CartItem[]
  notifications     CustomerNotification[]
  orders            Order[]
  orderInitiates    OrderInitiate[]
  reviews           Review[]
  wishlistItems     Wishlist[]
  wallet            CustomerWallet?
  userInteractions  UserInteraction[]
  preferredLanguage String?                @default("en-US")
    pushSubscriptions PushSubscription[]

}

model Wishlist {
  id             String       @id @default(uuid())
  customerUserId String
  productId      String
  createdAt      DateTime     @default(now())
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([customerUserId, productId])
}

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  password            String
  role                String                 @default("user")
  image               String?
  name                String?
  createdAt           DateTime               @default(now())
  businesses          Business[]
  notifications       SellerNotification[]
  performedActivities ActivityLog[]          @relation("PerformedUserActivities")
  sentSupportMessages SupportTicketMessage[]
  preferredLanguage   String?                @default("en-US")
  staffProfile        StaffMember?
    pushSubscriptions PushSubscription[]

}

model Permission {
  id          Int     @id @default(autoincrement())
  action      String // e.g., "read", "create", "update", "delete"
  subject     String // e.g., "Order", "Product", "Customer"
  description String?

  roles Role[] @relation("RolePermissions") // Many-to-many with Role

  @@unique([action, subject])
}

// --- Defines a role, which is a collection of permissions ---
model Role {
  id          Int      @id @default(autoincrement())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String // e.g., "Order Manager", "Product Uploader"
  description String?
  isDefault   Boolean  @default(false) // For default roles like "Owner"

  permissions Permission[]  @relation("RolePermissions") // Many-to-many with Permission
  staff       StaffMember[]

  @@unique([businessId, name])
}

model Address {
  id                     String       @id @default(uuid())
  street                 String
  city                   String
  state                  String
  postalCode             String
  country                String
  customerUserId         String
  alternativePhoneNumber String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  isDefault              Boolean      @default(false)
  landmark               String?
  latitude               Float?
  longitude              Float?
  type                   String       @default("HOME")
  notes                  String?
  customerUser           CustomerUser @relation(fields: [customerUserId], references: [id])
}

model Business {
  id                     String                  @id @default(uuid())
  name                   String
  gstNumber              String                  @unique
  address                String
  city                   String
  state                  String
  country                String
  postalCode             String
  phone                  String
  ownerId                String
  isVerified             Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  category               String                  @default("General")
  bankDetails            Json?
  bannerUrl              String?
  description            String?
  isActive               Boolean                 @default(true)
  logoUrl                String?
  rating                 Decimal                 @default(0)
  reviewCount            Int                     @default(0)
  slug                   String?                 @unique
  socialLinks            Json?
  websiteUrl             String?
  owner                  User                    @relation(fields: [ownerId], references: [id])
  itemUnits              ItemUnit[]
  products               Product[]
  reviews                Review[]
  sales                  Sale[]
  activities             ActivityLog[]           @relation("BusinessActivities")
  plan                   SubscriptionPlan        @default(FREE)
  subscriptionExpiresAt  DateTime?
  stripeCustomerId       String?                 @unique
  subscriptionPayments   SubscriptionPayment[]
  advertisementCampaigns AdvertisementCampaign[]
  supportTickets         SupportTicket[]
  staffMembers           StaffMember[]
  roles                  Role[]
}

model SellerNotification {
  id        String           @id @default(uuid())
  title     String
  message   String
  isRead    Boolean          @default(false)
  type      NotificationType @default(ORDER)
  metadata  Json?
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerNotification {
  id             String           @id @default(uuid())
  title          String
  message        String
  isRead         Boolean          @default(false)
  type           NotificationType @default(ORDER)
  metadata       Json?
  customerUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customerUser   CustomerUser     @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
}

model Category {
  id         Int         @id @default(autoincrement())
  name       String      @db.VarChar(255)
  slug       String      @unique
  parentId   Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  attributes Attribute[]
  products   Product[]
  parent     Category?   @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Category[]  @relation("SubCategories")

  @@map("category")
}

model Product {
  id                  String                   @id @default(uuid())
  title               String
  description         String?
  isCustomizable      Boolean                  @default(false)
  images              String[]
  isPublished         Boolean                  @default(false)
  isFeatured          Boolean                  @default(false)
  slug                String                   @unique
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  businessId          String
  categoryId          Int
  publishDate         DateTime?
  customizationConfig Json?
  model3dUrl          String?
  isArable            Boolean                  @default(false)
  searchVector        Unsupported("tsvector")? @map("search_vector")
  licenseDocumentUrl  String?                  @map("license_document_url")
  brand               String?
  metaDescription     String?
  metaTitle           String?
  tags                String[]
  business            Business                 @relation(fields: [businessId], references: [id])
  category            Category                 @relation(fields: [categoryId], references: [id])
  reviews             Review[]
  variants            Variant[]
  wishlistItems       Wishlist[]
  sponsorships        SponsoredProduct[]

  @@index([title])
  @@index([searchVector], map: "product_search_idx", type: Gin)
  @@index([tags], map: "product_tags_array_idx", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "product_title_trgm_idx", type: Gin)
}

model Variant {
  id                     String                  @id @default(uuid())
  sku                    String                  @unique
  price                  Decimal                 @db.Decimal(10, 2)
  stock                  Int
  isDefault              Boolean                 @default(false)
  weightInGrams          Int?
  images                 String[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  hsnCode                String?
  sacCode                String?
  mrp                    Decimal?                @db.Decimal(10, 2)
  purchasePrice          Decimal?                @db.Decimal(10, 2)
  purchasePriceType      String?                 @db.VarChar(64)
  tax                    String?                 @db.VarChar(128)
  minStockCount          Decimal?                @db.Decimal(10, 2)
  isMinStockAlertEnabled Boolean?
  productId              String
  status                 VariantStatus           @default(DRAFT)
  description            String?
  dimensionUnit          String?                 @default("CM")
  height                 Decimal?
  length                 Decimal?
  width                  Decimal?
  cartItems              CartItem[]
  batches                ItemBatching[]
  orderItems             OrderItem[]
  stockActivities        StockActivity[]
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues        VariantAttributeValue[]

  @@index([productId])
}

model Attribute {
  id            Int                     @id @default(autoincrement())
  name          String
  categoryId    Int
  position      Int                     @default(0)
  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options       AttributeOption[]
  variantValues VariantAttributeValue[]

  @@unique([name, categoryId])
}

model AttributeOption {
  id            Int                     @id @default(autoincrement())
  value         String
  attributeId   Int
  position      Int                     @default(0)
  slug          String
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_option")
}

model VariantAttributeValue {
  id                Int             @id @default(autoincrement())
  variantId         String
  attributeOptionId Int
  attributeId       Int
  attribute         Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeOption   AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Cascade)
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_attribute_value")
}

model Review {
  id                 String       @id @default(uuid())
  rating             Int
  comment            String?
  productId          String
  createdAt          DateTime     @default(now())
  businessId         String
  customerUserId     String
  images             String[]
  isVerifiedPurchase Boolean      @default(false)
  repliedAt          DateTime?
  reply              String?
  status             String       @default("APPROVED")
  title              String?
  business           Business     @relation(fields: [businessId], references: [id])
  customerUser       CustomerUser @relation(fields: [customerUserId], references: [id])
  product            Product      @relation(fields: [productId], references: [id])
}

model Order {
  id                    String        @id @default(uuid())
  totalAmount           Decimal
  customerUserId        String
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(pending)
  status                OrderStatus   @default(pending)
  selectedAddress       Json
  discount              Decimal       @default(0)
  taxAmount             Decimal       @default(0)
  shippingFee           Decimal       @default(0)
  trackingNumber        String?
  estimatedDeliveryDate DateTime?
  cancellationReason    String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  cancelledAt           DateTime?
  confirmedAt           DateTime?
  currency              String        @default("INR")
  deliveredAt           DateTime?
  ipAddress             String?
  isRefunded            Boolean       @default(false)
  orderNumber           String        @unique
  refundAmount          Decimal?
  shippedAt             DateTime?
  customerUser          CustomerUser  @relation(fields: [customerUserId], references: [id])
  items                 OrderItem[]
}

model OrderItem {
  id                   String   @id @default(uuid())
  quantity             Int
  priceAtTimeOfOrder   Decimal
  note                 String?
  orderId              String
  productId            String
  variantId            String?
  customizationDetails Json?
  customizationImages  String[]
  order                Order    @relation(fields: [orderId], references: [id])
  variant              Variant? @relation(fields: [variantId], references: [id])
}

model CartItem {
  id                   String       @id @default(uuid())
  quantity             Int
  productId            String
  variantId            String?
  customerUserId       String
  customizationDetails Json?
  customizationImages  String[]     @default([])
  customerUser         CustomerUser @relation(fields: [customerUserId], references: [id])
  variant              Variant?     @relation(fields: [variantId], references: [id])
}

model OrderInitiate {
  id             String              @id @default(uuid())
  orderId        String              @map("order_id")
  status         OrderInitiateStatus @default(pending)
  customerUserId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  customerUser   CustomerUser        @relation(fields: [customerUserId], references: [id])
}

model Discount {
  id                String           @id @default(uuid())
  name              String
  description       String?
  discountType      DiscountType     @map("discount_type")
  discountValue     Decimal          @map("discount_value")
  startDate         DateTime?        @map("start_date")
  endDate           DateTime?        @map("end_date")
  minOrderAmount    Decimal?         @map("min_order_amount")
  maxDiscountAmount Decimal?         @map("max_discount_amount")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  coupons           Coupon[]
  targets           DiscountTarget[]
}

model DiscountTarget {
  id         String     @id @default(uuid())
  discountId String     @map("discount_id")
  targetType TargetType @map("target_type")
  productId  String?    @map("product_id")
  categoryId Int?       @map("category_id")
  discount   Discount   @relation(fields: [discountId], references: [id])
}

model Coupon {
  id           String    @id @default(uuid())
  code         String    @unique
  active       Boolean   @default(true)
  discountId   String    @map("discount_id")
  maxUses      Int?      @map("max_uses")
  usedCount    Int       @default(0) @map("used_count")
  perUserLimit Int?      @map("per_user_limit")
  startsAt     DateTime? @map("starts_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  discount     Discount  @relation(fields: [discountId], references: [id])
}
model PushSubscription {
  id             String       @id @default(uuid())
  endpoint       String       @unique // The unique URL provided by the push service
  p256dh         String
  auth           String
  customerUserId String?
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([customerUserId])
  @@index([userId])
}
model PromotionalBanner {
  id             Int      @id @default(autoincrement())
  title          String
  discountText   String?
  bannerImageUrl String
  brandLogoUrl   String?
  targetUrl      String
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomepageSection {
  id          Int            @id @default(autoincrement())
  title       String?
  subtitle    String?
  isActive    Boolean        @default(true)
  position    Int            @default(0)
  endDate     DateTime?
  startDate   DateTime?
  styleConfig Json?
  type        SectionType
  items       HomepageItem[]
}

model HomepageItem {
  id          Int             @id @default(autoincrement())
  sectionId   Int
  title       String?
  subtitle    String?
  imageUrl    String?
  isActive    Boolean         @default(true)
  position    Int             @default(0)
  linkType    LinkType        @default(NONE)
  linkValue   String?
  styleConfig Json?
  videoUrl    String?
  section     HomepageSection @relation(fields: [sectionId], references: [id])
}

model Sale {
  id                        String                 @id @default(uuid())
  businessId                String
  partyId                   String
  saleType                  String                 @db.VarChar(128)
  invoicePrefix             String                 @db.VarChar(128)
  invoiceNo                 Int
  invoiceDate               DateTime
  isDueDateEnabled          Boolean
  dueDate                   DateTime
  paymentTerm               Int
  partyType                 String                 @db.VarChar(128)
  partyName                 String                 @db.VarChar(256)
  businessName              String                 @db.VarChar(256)
  billingAddress            String
  shippingAddress           String
  placeOfSupply             String                 @db.VarChar(128)
  phoneNo                   String                 @db.VarChar(36)
  taxId                     String                 @db.VarChar(128)
  panNo                     String                 @db.VarChar(128)
  isDiscountAfterTaxEnabled Boolean
  discountPercent           Decimal
  discountAmount            Decimal
  totalTaxableAmount        Decimal
  totalTaxAmount            Decimal
  isAutoRoundoffEnabled     Boolean
  roundoffType              String                 @db.VarChar(64)
  roundoffAmount            Decimal
  totalAmount               Decimal
  isSettled                 Boolean
  balanceAmount             Decimal
  termCondition             String
  notes                     String
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  isScanItemEnabled         Boolean
  isConverted               Boolean
  party                     String
  ackNumber                 String?
  eWayBillNumber            String?
  pdfUrl                    String?
  status                    String                 @default("FINALIZED")
  customField               CustomField?
  business                  Business               @relation(fields: [businessId], references: [id])
  saleAdditionalCharges     SaleAdditionalCharge[]
  saleItems                 SaleItem[]
  salePaymentModes          SalePaymentMode[]
  saleTaxes                 SaleTax[]
}

model SaleItem {
  id                     String   @id @default(uuid()) @map("saleItemId")
  itemId                 String
  itemName               String   @db.VarChar(512)
  itemDescription        String
  hsnCode                String   @db.VarChar(128)
  sacCode                String   @db.VarChar(128)
  batchNo                String   @db.VarChar(128)
  manufactureDate        DateTime
  expiryDate             DateTime
  quantity               Decimal
  price                  Decimal
  priceType              String   @db.VarChar(64)
  unit                   String   @db.VarChar(128)
  discountPercent        Decimal
  discountAmount         Decimal
  taxableAmount          Decimal
  tax                    String   @db.VarChar(128)
  taxAmount              Decimal
  cess                   String   @db.VarChar(128)
  cessAmount             Decimal
  amount                 Decimal
  isMrpEnabled           Boolean
  isWholesaleEnabled     Boolean
  isSerialisationEnabled Boolean
  isBatchingEnabled      Boolean
  sellingPrice           Decimal
  sellingPriceType       String   @db.VarChar(64)
  purchasePrice          Decimal
  purchasePriceType      String   @db.VarChar(64)
  mrp                    Decimal
  wholesalePrice         Decimal
  wholesalePriceType     String   @db.VarChar(64)
  wholesaleQuantity      Decimal
  itemCode               String   @db.VarChar(128)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  saleId                 String
  sale                   Sale     @relation(fields: [saleId], references: [id])
}

model SaleAdditionalCharge {
  id        String   @id @default(uuid()) @map("saleAdditionalChargeId")
  name      String   @db.VarChar(256)
  amount    Decimal
  tax       String   @db.VarChar(128)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
}

model SalePaymentMode {
  id               String   @id @default(uuid()) @map("salePaymentModeId")
  bankCashChequeId String
  accountName      String   @db.VarChar(256)
  paymentMode      String   @db.VarChar(128)
  amount           Decimal
  ifsc             String   @db.VarChar(20)
  acNo             String   @db.VarChar(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  saleId           String
  sale             Sale     @relation(fields: [saleId], references: [id])
}

model SaleTax {
  id            String   @id @default(uuid()) @map("saleTaxId")
  taxRate       Decimal
  taxableAmount Decimal
  cgst          Decimal
  sgst          Decimal
  igst          Decimal
  cess          Decimal
  total         Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hsnCode       String   @db.VarChar(128)
  sacCode       String   @db.VarChar(128)
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
}

model CustomField {
  id        String   @id @default(uuid())
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  saleId    String?  @unique
  sale      Sale?    @relation(fields: [saleId], references: [id])
}

model ItemBatching {
  batchNo             String   @db.VarChar(128)
  manufactureDate     DateTime
  expiryDate          DateTime
  sellingPrice        Decimal
  sellingPriceType    String   @db.VarChar(64)
  purchasePrice       Decimal
  purchasePriceType   String   @db.VarChar(64)
  mrp                 Decimal
  unit                String   @db.VarChar(128)
  isSecondUnitEnabled Boolean
  secondUnit          String   @db.VarChar(128)
  conversionRate      Decimal
  openingStock        Decimal
  openingStockDate    DateTime
  closingStock        Decimal
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  id                  String   @id @default(uuid())
  variantId           String?
  variant             Variant? @relation(fields: [variantId], references: [id])
}

model ItemSerialisation {
  serialNo     String   @db.VarChar(128)
  serialNoDate DateTime
  isAvailable  Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  id           String   @id @default(uuid())
}

model ItemUnit {
  id         String   @id @default(uuid())
  businessId String
  unitName   String   @db.VarChar(128)
  isEnabled  Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
}

model StockActivity {
  id            String   @id @default(uuid())
  businessId    String
  itemId        String
  activityType  String   @db.VarChar(128)
  invoicePrefix String   @db.VarChar(128)
  invoiceNo     Int
  quantity      Decimal
  closingStock  Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  variantId     String?
  variant       Variant? @relation(fields: [variantId], references: [id])
}

model ActivityLog {
  id                String    @id @default(uuid())
  actionType        String
  entityType        String
  entityId          String?
  description       String
  details           Json?
  createdAt         DateTime  @default(now())
  performedByUserId String?
  businessId        String?
  business          Business? @relation("BusinessActivities", fields: [businessId], references: [id])
  performedByUser   User?     @relation("PerformedUserActivities", fields: [performedByUserId], references: [id])

  @@index([businessId])
  @@index([performedByUserId])
  @@index([createdAt])
  @@map("activity_log")
}

model PredefinedCategory {
  id            String                  @id @default(uuid())
  categoryName  String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  subcategories PredefinedSubCategory[]
}

model PredefinedSubCategory {
  id              String             @id @default(uuid())
  subCategoryName String
  categoryId      String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  category        PredefinedCategory @relation(fields: [categoryId], references: [id])
  images          SubCategoryImage[]
}

model SubCategoryImage {
  id            String                @id @default(uuid())
  subCategoryId String
  url           String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subCategory   PredefinedSubCategory @relation(fields: [subCategoryId], references: [id])
}

model CategoryOrSubcategoryImage {
  id                      String   @id @default(uuid())
  categoryOrSubcategoryId String
  type                    String
  url                     String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model StaffMember {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name   String
  phone  String? @unique
  email  String? @unique
  roleId Int?
  role   Role?   @relation(fields: [roleId], references: [id])

  address        String?
  roleTitle      String // e.g., "Warehouse Manager", "Packer", "Sales Associate"
  employmentType EmploymentType @default(FULL_TIME)
  joiningDate    DateTime
  isActive       Boolean        @default(true) // To mark former employees

  // Wage & Salary Information
  wageType   String // e.g., "MONTHLY_SALARY", "HOURLY_WAGE"
  wageAmount Decimal

  // Link to a User account for platform access (optional)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  attendance    Attendance[]
  salaryPayouts SalaryPayout[]

  @@index([businessId])
}

// --- Attendance Tracking ---
model Attendance {
  id            String      @id @default(uuid())
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])

  date         DateTime         @db.Date // Store only the date part
  status       AttendanceStatus
  checkInTime  DateTime?
  checkOutTime DateTime?
  notes        String? // e.g., "Late due to traffic", "Approved leave"

  @@unique([staffMemberId, date]) // A staff member can only have one attendance record per day
}

// --- Salary & Payout History ---
model SalaryPayout {
  id            String      @id @default(uuid())
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])

  payoutDate     DateTime
  amountPaid     Decimal
  paymentPeriod  String // e.g., "December 2026"
  paymentMethod  String // e.g., "Bank Transfer", "Cash"
  transactionRef String? // Bank transaction reference
  notes          String?

  @@index([staffMemberId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

// Defines the status of an attendance record
enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  HALF_DAY
}

enum NotificationType {
  ORDER
  SYSTEM
  PROMOTION
  ALERT
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

// For Advertisement Campaigns
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// For the Customer Wallet System
enum WalletTransactionType {
  REFUND
  CASHBACK
  PROMOTIONAL_CREDIT
  PURCHASE_DEBIT
  GIFT_CARD_REDEMPTION
  MANUAL_ADJUSTMENT
}

// For the User Behavior Tracking System
enum UserInteractionType {
  PRODUCT_VIEW
  CATEGORY_VIEW
  SEARCH
  ADD_TO_CART
  ADD_TO_WISHLIST
  ORDER_PLACED
}

model SubscriptionPayment {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id])
  plan            SubscriptionPlan
  amount          Decimal
  paymentGateway  String // e.g., "Stripe", "Razorpay"
  transactionId   String           @unique
  paidAt          DateTime         @default(now())
  periodStartDate DateTime
  periodEndDate   DateTime

  @@index([businessId])
}

// --- 2. ADVERTISING & SPONSORED PRODUCTS ---

model AdvertisementCampaign {
  id          String         @id @default(uuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id])
  name        String
  budget      Decimal
  spentAmount Decimal        @default(0)
  startDate   DateTime
  endDate     DateTime?
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sponsoredProducts SponsoredProduct[]

  @@index([businessId])
}

model SponsoredProduct {
  id               String                @id @default(uuid())
  campaignId       String
  campaign         AdvertisementCampaign @relation(fields: [campaignId], references: [id])
  productId        String
  product          Product               @relation(fields: [productId], references: [id])
  cpc              Decimal? // Cost-Per-Click
  cpm              Decimal? // Cost-Per-Mille (1000 impressions)
  totalClicks      Int                   @default(0)
  totalImpressions Int                   @default(0)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())

  @@unique([campaignId, productId])
  @@index([productId])
}

// --- 3. CUSTOMER WALLET SYSTEM ---

model CustomerWallet {
  id             String       @id @default(uuid())
  customerUserId String       @unique
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id])
  balance        Decimal      @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String                @id @default(uuid())
  walletId  String
  wallet    CustomerWallet        @relation(fields: [walletId], references: [id])
  amount    Decimal // Can be positive (credit) or negative (debit)
  type      WalletTransactionType
  metadata  Json? // e.g., { "orderId": "...", "reason": "Returned item" }
  createdAt DateTime              @default(now())

  @@index([walletId])
}

// --- 4. USER BEHAVIOR TRACKING ---

model UserInteraction {
  id             BigInt              @id @default(autoincrement())
  customerUserId String?
  customerUser   CustomerUser?       @relation(fields: [customerUserId], references: [id])
  sessionId      String // To group anonymous actions
  eventType      UserInteractionType
  entityId       String? // The ID of the product, category, etc.
  metadata       Json? // e.g., { "searchQuery": "red shoes" }
  timestamp      DateTime            @default(now())

  @@index([customerUserId])
  @@index([eventType])
  @@index([timestamp])
}

// --- 5. SELLER SUPPORT TICKETING SYSTEM ---

model SupportTicket {
  id          String         @id @default(uuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id])
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages SupportTicketMessage[]

  @@index([businessId])
}

model SupportTicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  senderId  String // The ID of the User (seller or admin) who sent it
  sender    User          @relation(fields: [senderId], references: [id])
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// For the Seller Support Ticketing System
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SectionType {
  HERO_SLIDER
  SCROLLABLE_ROW
  GRID_2XN
  GRID_3XN
  GRID_SQUARE_COMPACT
  SINGLE_BANNER
  PRODUCT_CAROUSEL
}

enum LinkType {
  NONE
  CATEGORY
  PRODUCT
  BRAND
  SEARCH
  EXTERNAL_URL
}

enum TargetType {
  PRODUCT
  CATEGORY
}

enum DiscountType {
  percentage
  fixed_amount
  free_shipping
}

enum AuthSource {
  self
  google
}

enum Unit {
  PCS
  GRAM
  KG
  LITER
}

enum VariantStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PriceType {
  MRP
  Discounted
  Offer
}

enum CustomerType {
  basic
  pro
  user
}

enum PaymentMethod {
  online
  cash_on_delivery
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum OrderInitiateStatus {
  pending
  completed
}
