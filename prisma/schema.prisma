generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CustomerUser {
  id                String                 @id @default(uuid())
  email             String                 @unique
  picture           String?
  name              String
  password          String?
  authSource        AuthSource             @default(self)
  type              CustomerType           @default(user)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  gender            String?
  isActive          Boolean                @default(true)
  isEmailVerified   Boolean                @default(false)
  isPhoneVerified   Boolean                @default(false)
  lastLoginAt       DateTime?
  phoneNumber       String?                @unique
  addresses         Address[]
  cartItems         CartItem[]
  notifications     CustomerNotification[]
  orders            Order[]
  orderInitiates    OrderInitiate[]
  productWaitlists ProductWaitlist[]
  reviews           Review[]
  appointments Appointment[]
  wishlistItems     Wishlist[]
  wallet            CustomerWallet?
  userInteractions  UserInteraction[]
  preferredLanguage String?                @default("en-US")
  pushSubscriptions PushSubscription[]
  deletedAt         DateTime?
}

model Wishlist {
  id             String       @id @default(uuid())
  customerUserId String
  productId      String
  createdAt      DateTime     @default(now())
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([customerUserId, productId])
}

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  password            String
  role                String                 @default("user")
  image               String?
  name                String?
  identityVerified    Boolean                @default(false)
  lastKycReviewAt     DateTime?
  createdAt           DateTime               @default(now())
  businesses          Business[]
  notifications       SellerNotification[]
  performedActivities ActivityLog[]          @relation("PerformedUserActivities")
  sentSupportMessages SupportTicketMessage[]
  preferredLanguage   String?                @default("en-US")
  staffProfile        StaffMember?
  pushSubscriptions   PushSubscription[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  action      String // e.g., "read", "create", "update", "delete"
  subject     String // e.g., "Order", "Product", "Customer"
  description String?

  roles Role[] @relation("RolePermissions") // Many-to-many with Role

  @@unique([action, subject])
}

// --- Defines a role, which is a collection of permissions ---
model Role {
  id          Int      @id @default(autoincrement())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String // e.g., "Order Manager", "Product Uploader"
  description String?
  isDefault   Boolean  @default(false) // For default roles like "Owner"

  permissions Permission[]  @relation("RolePermissions") // Many-to-many with Permission
  staff       StaffMember[]

  @@unique([businessId, name])
}

model Address {
  id                     String       @id @default(uuid())
  street                 String
  city                   String
  state                  String
  postalCode             String
  country                String
  customerUserId         String
  alternativePhoneNumber String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  isDefault              Boolean      @default(false)
  landmark               String?
  latitude               Float?
  longitude              Float?
  type                   String       @default("HOME")
  notes                  String?
  customerUser           CustomerUser @relation(fields: [customerUserId], references: [id])
}

model Business {
  id                        String                      @id @default(uuid())
  name                      String
  gstNumber                 String                      @unique
  address                   String
  city                      String
  state                     String
  country                   String
  postalCode                String
  phone                     String
  ownerId                   String
  isVerified                Boolean                     @default(false)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  category                  String                      @default("General")
  bankDetails               Json?
  bannerUrl                 String?
  description               String?
  isActive                  Boolean                     @default(true)
  logoUrl                   String?
  rating                    Decimal                     @default(0)
  reviewCount               Int                         @default(0)
  slug                      String?                     @unique
  socialLinks               Json?
  websiteUrl                String?
  businessType              String                      @default("PROPRIETORSHIP")
  legalName                 String? // Legal name from PAN card
  panNumber                 String?                     @unique // Should be unique
  kycStatus                 SellerKycStatus             @default(PENDING)
  kycSubmittedAt            DateTime?
  kycVerifiedAt             DateTime?
  kycRejectedAt             DateTime?
  kycRemarks                String?
  sellerAgreementAccepted   Boolean                     @default(false)
  sellerAgreementVersion    String?
  sellerAgreementAcceptedAt DateTime?
  isPayoutEnabled           Boolean                     @default(false)
  kycDocumentsJson          Json?                       @map("kyc_documents")
  owner                     User                        @relation(fields: [ownerId], references: [id])
  purchases                 Purchase[]
  expenses                  Expense[]
  activities                ActivityLog[]               @relation("BusinessActivities")
  itemUnits                 ItemUnit[]
  bankAccounts              BankCashCheque[]
  ledgerEntries             BankCashChequeTransaction[]
  products                  Product[]
  reviews                   Review[]
  sales                     Sale[]
  plan                      SubscriptionPlan            @default(FREE)
  subscriptionExpiresAt     DateTime?
  stripeCustomerId          String?                     @unique
  subscriptionPayments      SubscriptionPayment[]
  advertisementCampaigns    AdvertisementCampaign[]
  supportTickets            SupportTicket[]
  staffMembers              StaffMember[]
  roles                     Role[]
  kycDocuments              SellerKycDocument[]
  settlements               SellerSettlement[]
  agreementLogs             SellerAgreementLog[]
  quotations                Quotation[]
  challans                  DeliveryChallan[]
  creditNotes               CreditNote[]
  debitNotes                DebitNote[]
  warehouses                Warehouse[]
  productWaitlists ProductWaitlist[]
  taxEntries                TaxEntry[]
  partyLedgers              PartyLedger[]
  fixedAssets               FixedAsset[] // Add this relation
  industryType IndustryType @default(RETAIL_GENERAL)
  businessConfig Json?  @default("{}")

  // 3. Operational Details
  currency      String   @default("INR")
  timezone      String   @default("Asia/Kolkata")
  
  // 4. Relations to new modules
  tables        RestaurantTable[]      // For Restaurants
  modifierGroups ModifierGroup[]       // For Food Add-ons (Extra Cheese, No Ice)
  kitchenTickets KitchenTicket[]       // KOTs
  appointments   Appointment[]     

}
model Appointment {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])

  // Who is coming?
  customerUserId String?
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id])
  customerName   String?       // For walk-ins/guests without an account
  customerPhone  String?

  // Who is providing the service? (Stylist, Doctor, Mechanic)
  staffId     String?
  staff       StaffMember? @relation(fields: [staffId], references: [id])

  // What is the service? (Linked to Product table where type = SERVICE)
  serviceId   String
  service     Product      @relation(fields: [serviceId], references: [id])

  // When?
  startTime   DateTime
  endTime     DateTime     // Derived from Product duration
  
  status      AppointmentStatus @default(PENDING)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@index([staffId])
  @@index([startTime])
}

model SellerNotification {
  id        String           @id @default(uuid())
  title     String
  message   String
  isRead    Boolean          @default(false)
  type      NotificationType @default(ORDER)
  metadata  Json?
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerNotification {
  id             String           @id @default(uuid())
  title          String
  message        String
  isRead         Boolean          @default(false)
  type           NotificationType @default(ORDER)
  metadata       Json?
  customerUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customerUser   CustomerUser     @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
}

model Category {
  id             Int         @id @default(autoincrement())
  name           String      @db.VarChar(255)
  slug           String      @unique
  parentId       Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  attributes     Attribute[]
  products       Product[]
  parent         Category?   @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Category[]  @relation("SubCategories")
  gstRate        Decimal     @default(0) // The GST percentage applicable to products in this category (e.g., 18 for 18%).
  commissionRate Decimal? // Optional: Platform commission rate for this category, can override a global setting.

  // 2. Display & Marketing
  imageUrl    String? // URL for the category's banner or thumbnail image.
  description String? // A short description for the category page (good for SEO).
  position    Int     @default(0) // For manually sorting categories in menus (e.g., 0=Top, 1=Next).
  isActive    Boolean @default(true) // Allows admins to hide a category without deleting it.

  // 3. SEO Metadata
  metaTitle       String? // Custom title for the browser tab and Google search results.
  metaDescription String?

  @@map("category")
}

model Product {
  id                  String                   @id @default(uuid())
  title               String
  description         String?
  isCustomizable      Boolean                  @default(false)
  images              String[]
  isPublished         Boolean                  @default(false)
  isFeatured          Boolean                  @default(false)
  slug                String                   @unique
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  businessId          String
  categoryId          Int
  publishDate         DateTime?
  appointments Appointment[]
  customizationConfig Json?
  model3dUrl          String?
  isArable            Boolean                  @default(false)
  searchVector        Unsupported("tsvector")? @map("search_vector")
  licenseDocumentUrl  String?                  @map("license_document_url")
  brand               String?
  metaDescription     String?
  metaTitle           String?
  tags                String[]
  business            Business                 @relation(fields: [businessId], references: [id])
  category            Category                 @relation(fields: [categoryId], references: [id])
  reviews             Review[]
  variants            Variant[]
  wishlistItems       Wishlist[]
  productWaitlists ProductWaitlist[]
  sponsorships        SponsoredProduct[]
  deletedAt           DateTime?
  productType   ProductType @default(STANDARD)
 modifierGroups ProductModifier[] 
  recipe         BillOfMaterial?   // See below
  @@index([title])
  @@index([searchVector], map: "product_search_idx", type: Gin)
  @@index([tags], map: "product_tags_array_idx", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "product_title_trgm_idx", type: Gin)
}

model Variant {
  id                     String                  @id @default(uuid())
  sku                    String                  @unique
  price                  Decimal                 @db.Decimal(10, 2)
  stock                  Int
  isDefault              Boolean                 @default(false)
  weightInGrams          Int?
  images                 String[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  hsnCode                String?
  sacCode                String?
  mrp                    Decimal?                @db.Decimal(10, 2)
  purchasePrice          Decimal?                @db.Decimal(10, 2)
  purchasePriceType      String?                 @db.VarChar(64)
  tax                    String?                 @db.VarChar(128)
  minStockCount          Decimal?                @db.Decimal(10, 2)
  isMinStockAlertEnabled Boolean?
  productId              String
  status                 VariantStatus           @default(DRAFT)
  description            String?
  dimensionUnit          String?                 @default("CM")
  height                 Decimal?
  length                 Decimal?
  width                  Decimal?
  cartItems              CartItem[]
  batches                ItemBatching[]
  orderItems             OrderItem[]
  stockActivities        StockActivity[]
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues        VariantAttributeValue[]
  purchaseItems          PurchaseItem[]
  warehouseStocks        WarehouseStock[]
  productWaitlists ProductWaitlist[]
  bomItems         BomItem[] 
  deletedAt              DateTime?

  @@index([productId])
}

model Attribute {
  id            Int                     @id @default(autoincrement())
  name          String
  categoryId    Int
  position      Int                     @default(0)
  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options       AttributeOption[]
  variantValues VariantAttributeValue[]

  @@unique([name, categoryId])
}

model AttributeOption {
  id            Int                     @id @default(autoincrement())
  value         String
  attributeId   Int
  position      Int                     @default(0)
  slug          String
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_option")
}

model VariantAttributeValue {
  id                Int             @id @default(autoincrement())
  variantId         String
  attributeOptionId Int
  attributeId       Int
  attribute         Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeOption   AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Cascade)
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_attribute_value")
}

model BillOfMaterial {
  id          String   @id @default(uuid())
  productId   String   @unique // The "Parent" (e.g., Chicken Burger)
  product     Product  @relation(fields: [productId], references: [id])

  items       BomItem[]
}

model BomItem {
  id             String         @id @default(uuid())
  billOfMaterialId String
  billOfMaterial BillOfMaterial @relation(fields: [billOfMaterialId], references: [id])

  // The "Child" ingredient (e.g., Burger Bun)
  variantId      String         
  variant        Variant        @relation(fields: [variantId], references: [id])

  quantity       Decimal        // How much to deduct (e.g., 0.05 KG of Cheese)
}
model Review {
  id                 String       @id @default(uuid())
  rating             Int
  comment            String?
  productId          String
  createdAt          DateTime     @default(now())
  businessId         String
  customerUserId     String
  images             String[]
  isVerifiedPurchase Boolean      @default(false)
  repliedAt          DateTime?
  reply              String?
  status             String       @default("APPROVED")
  title              String?
  business           Business     @relation(fields: [businessId], references: [id])
  customerUser       CustomerUser @relation(fields: [customerUserId], references: [id])
  product            Product      @relation(fields: [productId], references: [id])
}

model Order {
  id                    String             @id @default(uuid())
  totalAmount           Decimal
  customerUserId        String
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus      @default(pending)
  status                OrderStatus        @default(pending)
  selectedAddress       Json
  discount              Decimal            @default(0)
  taxAmount             Decimal            @default(0)
  shippingFee           Decimal            @default(0)
  trackingNumber        String?
  estimatedDeliveryDate DateTime?
  cancellationReason    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  cancelledAt           DateTime?
  confirmedAt           DateTime?
  currency              String             @default("INR")
  deliveredAt           DateTime?
  ipAddress             String?
  isRefunded            Boolean            @default(false)
  orderNumber           String             @unique
  refundAmount          Decimal?
  shippedAt             DateTime?
  customerUser          CustomerUser       @relation(fields: [customerUserId], references: [id])
  items                 OrderItem[]
  returnRequests        ReturnRequest[] // <-- FIX for the first error
  settlements           SellerSettlement[]
}

model OrderItem {
  id                   String       @id @default(uuid())
  quantity             Int
  priceAtTimeOfOrder   Decimal
  note                 String?
  orderId              String
  productId            String
  variantId            String?
  customizationDetails Json?
  customizationImages  String[]
  order                Order        @relation(fields: [orderId], references: [id])
  variant              Variant?     @relation(fields: [variantId], references: [id])
  returnedIn           ReturnItem[] // <-- FIX for the second error (replaces 'returnRequests')
}

model CartItem {
  id                   String       @id @default(uuid())
  quantity             Int
  productId            String
  variantId            String?
  customerUserId       String
  customizationDetails Json?
  customizationImages  String[]     @default([])
  customerUser         CustomerUser @relation(fields: [customerUserId], references: [id])
  variant              Variant?     @relation(fields: [variantId], references: [id])
}

model OrderInitiate {
  id             String              @id @default(uuid())
  orderId        String              @map("order_id")
  status         OrderInitiateStatus @default(pending)
  customerUserId String
  createdAt      DateTime            @default(now())
  details        Json?
  updatedAt      DateTime            @updatedAt
  customerUser   CustomerUser        @relation(fields: [customerUserId], references: [id])
}

model Discount {
  id                String           @id @default(uuid())
  name              String
  description       String?
  discountType      DiscountType     @map("discount_type")
  discountValue     Decimal          @map("discount_value")
  startDate         DateTime?        @map("start_date")
  endDate           DateTime?        @map("end_date")
  minOrderAmount    Decimal?         @map("min_order_amount")
  maxDiscountAmount Decimal?         @map("max_discount_amount")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  coupons           Coupon[]
  targets           DiscountTarget[]
}

model DiscountTarget {
  id         String     @id @default(uuid())
  discountId String     @map("discount_id")
  targetType TargetType @map("target_type")
  productId  String?    @map("product_id")
  categoryId Int?       @map("category_id")
  discount   Discount   @relation(fields: [discountId], references: [id])
}

model Coupon {
  id           String    @id @default(uuid())
  code         String    @unique
  active       Boolean   @default(true)
  discountId   String    @map("discount_id")
  maxUses      Int?      @map("max_uses")
  usedCount    Int       @default(0) @map("used_count")
  perUserLimit Int?      @map("per_user_limit")
  startsAt     DateTime? @map("starts_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  discount     Discount  @relation(fields: [discountId], references: [id])
}

model PushSubscription {
  id             String        @id @default(uuid())
  endpoint       String        @unique // The unique URL provided by the push service
  p256dh         String
  auth           String
  customerUserId String?
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([customerUserId])
  @@index([userId])
}

model PromotionalBanner {
  id             Int      @id @default(autoincrement())
  title          String
  discountText   String?
  bannerImageUrl String
  brandLogoUrl   String?
  targetUrl      String
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomepageSection {
  id          Int            @id @default(autoincrement())
  title       String?
  subtitle    String?
  isActive    Boolean        @default(true)
  position    Int            @default(0)
  endDate     DateTime?
  startDate   DateTime?
  styleConfig Json?
  type        SectionType
  items       HomepageItem[]
}

model HomepageItem {
  id          Int             @id @default(autoincrement())
  sectionId   Int
  title       String?
  subtitle    String?
  imageUrl    String?
  isActive    Boolean         @default(true)
  position    Int             @default(0)
  linkType    LinkType        @default(NONE)
  linkValue   String?
  styleConfig Json?
  videoUrl    String?
  section     HomepageSection @relation(fields: [sectionId], references: [id])
}

model Sale {
  id                        String                 @id @default(uuid())
  businessId                String
  partyId                   String
  saleType                  String                 @db.VarChar(128)
  invoicePrefix             String                 @db.VarChar(128)
  invoiceNo                 Int
  invoiceDate               DateTime
  isDueDateEnabled          Boolean
  dueDate                   DateTime
  paymentTerm               Int
  partyType                 String                 @db.VarChar(128)
  partyName                 String                 @db.VarChar(256)
  businessName              String                 @db.VarChar(256)
  billingAddress            String
  shippingAddress           String
  placeOfSupply             String                 @db.VarChar(128)
  phoneNo                   String                 @db.VarChar(36)
  taxId                     String                 @db.VarChar(128)
  panNo                     String                 @db.VarChar(128)
  isDiscountAfterTaxEnabled Boolean
  discountPercent           Decimal
  discountAmount            Decimal
  totalTaxableAmount        Decimal
  totalTaxAmount            Decimal
  isAutoRoundoffEnabled     Boolean
  roundoffType              String                 @db.VarChar(64)
  roundoffAmount            Decimal
  totalAmount               Decimal
  isSettled                 Boolean
  balanceAmount             Decimal
  termCondition             String
  notes                     String
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  isScanItemEnabled         Boolean
  isConverted               Boolean
  party                     String
  ackNumber                 String?
  eWayBillNumber            String?
  pdfUrl                    String?
  status                    String                 @default("FINALIZED")
  customField               CustomField?
  business                  Business               @relation(fields: [businessId], references: [id])
  saleAdditionalCharges     SaleAdditionalCharge[]
  saleItems                 SaleItem[]
  salePaymentModes          SalePaymentMode[]
  creditNotes               CreditNote[]
  saleTaxes                 SaleTax[]
  deletedAt                 DateTime?
}

model SaleItem {
  id                     String   @id @default(uuid()) @map("saleItemId")
  itemId                 String
  itemName               String   @db.VarChar(512)
  itemDescription        String
  hsnCode                String   @db.VarChar(128)
  sacCode                String   @db.VarChar(128)
  batchNo                String   @db.VarChar(128)
  manufactureDate        DateTime
  expiryDate             DateTime
  quantity               Decimal
  price                  Decimal
  priceType              String   @db.VarChar(64)
  unit                   String   @db.VarChar(128)
  discountPercent        Decimal
  discountAmount         Decimal
  taxableAmount          Decimal
  tax                    String   @db.VarChar(128)
  taxAmount              Decimal
  cess                   String   @db.VarChar(128)
  cessAmount             Decimal
  amount                 Decimal
  isMrpEnabled           Boolean
  isWholesaleEnabled     Boolean
  isSerialisationEnabled Boolean
  isBatchingEnabled      Boolean
  sellingPrice           Decimal
  sellingPriceType       String   @db.VarChar(64)
  purchasePrice          Decimal
  purchasePriceType      String   @db.VarChar(64)
  mrp                    Decimal
  wholesalePrice         Decimal
  wholesalePriceType     String   @db.VarChar(64)
  wholesaleQuantity      Decimal
  itemCode               String   @db.VarChar(128)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  saleId                 String
  sale                   Sale     @relation(fields: [saleId], references: [id])
}

model SaleAdditionalCharge {
  id        String   @id @default(uuid()) @map("saleAdditionalChargeId")
  name      String   @db.VarChar(256)
  amount    Decimal
  tax       String   @db.VarChar(128)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
}

model SalePaymentMode {
  id               String          @id @default(uuid()) @map("salePaymentModeId")
  bankCashChequeId String
  accountName      String          @db.VarChar(256)
  paymentMode      String          @db.VarChar(128)
  amount           Decimal
  ifsc             String          @db.VarChar(20)
  acNo             String          @db.VarChar(20)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id])
  bankAccount      BankCashCheque? @relation(fields: [bankCashChequeId], references: [id])
}

model SaleTax {
  id            String   @id @default(uuid()) @map("saleTaxId")
  taxRate       Decimal
  taxableAmount Decimal
  cgst          Decimal
  sgst          Decimal
  igst          Decimal
  cess          Decimal
  total         Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hsnCode       String   @db.VarChar(128)
  sacCode       String   @db.VarChar(128)
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
}

model CustomField {
  id        String   @id @default(uuid())
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  saleId    String?  @unique
  sale      Sale?    @relation(fields: [saleId], references: [id])
}

model ItemBatching {
  batchNo             String   @db.VarChar(128)
  manufactureDate     DateTime
  expiryDate          DateTime
  sellingPrice        Decimal
  sellingPriceType    String   @db.VarChar(64)
  purchasePrice       Decimal
  purchasePriceType   String   @db.VarChar(64)
  mrp                 Decimal
  unit                String   @db.VarChar(128)
  isSecondUnitEnabled Boolean
  secondUnit          String   @db.VarChar(128)
  conversionRate      Decimal
  openingStock        Decimal
  openingStockDate    DateTime
  closingStock        Decimal
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  id                  String   @id @default(uuid())
  variantId           String?
  variant             Variant? @relation(fields: [variantId], references: [id])
}

model ItemSerialisation {
  serialNo     String   @db.VarChar(128)
  serialNoDate DateTime
  isAvailable  Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  id           String   @id @default(uuid())
}

model ItemUnit {
  id         String   @id @default(uuid())
  businessId String
  unitName   String   @db.VarChar(128)
  isEnabled  Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
}

model StockActivity {
  id            String   @id @default(uuid())
  businessId    String
  itemId        String
  activityType  String   @db.VarChar(128)
  invoicePrefix String   @db.VarChar(128)
  invoiceNo     Int
  quantity      Decimal
  closingStock  Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  variantId     String?
  variant       Variant? @relation(fields: [variantId], references: [id])
}

model ActivityLog {
  id                String    @id @default(uuid())
  actionType        String
  entityType        String
  entityId          String?
  description       String
  details           Json?
  createdAt         DateTime  @default(now())
  performedByUserId String?
  businessId        String?
  business          Business? @relation("BusinessActivities", fields: [businessId], references: [id])
  performedByUser   User?     @relation("PerformedUserActivities", fields: [performedByUserId], references: [id])

  @@index([businessId])
  @@index([performedByUserId])
  @@index([createdAt])
  @@map("activity_log")
}

model PredefinedCategory {
  id            String                  @id @default(uuid())
  categoryName  String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  subcategories PredefinedSubCategory[]
}

model PredefinedSubCategory {
  id              String             @id @default(uuid())
  subCategoryName String
  categoryId      String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  category        PredefinedCategory @relation(fields: [categoryId], references: [id])
  images          SubCategoryImage[]
}

model SubCategoryImage {
  id            String                @id @default(uuid())
  subCategoryId String
  url           String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subCategory   PredefinedSubCategory @relation(fields: [subCategoryId], references: [id])
}

model CategoryOrSubcategoryImage {
  id                      String   @id @default(uuid())
  categoryOrSubcategoryId String
  type                    String
  url                     String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model StaffMember {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name   String
  phone  String? @unique
  email  String? @unique
  roleId Int?
  role   Role?   @relation(fields: [roleId], references: [id])

  address        String?
  roleTitle      String // e.g., "Warehouse Manager", "Packer", "Sales Associate"
  employmentType EmploymentType @default(FULL_TIME)
  joiningDate    DateTime
  isActive       Boolean        @default(true) // To mark former employees

  // Wage & Salary Information
  wageType   String // e.g., "MONTHLY_SALARY", "HOURLY_WAGE"
  wageAmount Decimal

  // Link to a User account for platform access (optional)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  attendance    Attendance[]
  salaryPayouts SalaryPayout[]
appointments Appointment[]

  @@index([businessId])
}

// --- Attendance Tracking ---
model Attendance {
  id            String      @id @default(uuid())
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])

  date         DateTime         @db.Date // Store only the date part
  status       AttendanceStatus
  checkInTime  DateTime?
  checkOutTime DateTime?
  notes        String? // e.g., "Late due to traffic", "Approved leave"

  @@unique([staffMemberId, date]) // A staff member can only have one attendance record per day
}

// --- Salary & Payout History ---
model SalaryPayout {
  id            String      @id @default(uuid())
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])

  payoutDate     DateTime
  amountPaid     Decimal
  paymentPeriod  String // e.g., "December 2026"
  paymentMethod  String // e.g., "Bank Transfer", "Cash"
  transactionRef String? // Bank transaction reference
  notes          String?

  @@index([staffMemberId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

// Defines the status of an attendance record
enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  HALF_DAY
}

enum NotificationType {
  ORDER
  SYSTEM
  PROMOTION
  ALERT
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

// For Advertisement Campaigns
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// For the Customer Wallet System
enum WalletTransactionType {
  REFUND
  CASHBACK
  PROMOTIONAL_CREDIT
  PURCHASE_DEBIT
  GIFT_CARD_REDEMPTION
  MANUAL_ADJUSTMENT
}

// For the User Behavior Tracking System
enum UserInteractionType {
  PRODUCT_VIEW
  CATEGORY_VIEW
  SEARCH
  ADD_TO_CART
  ADD_TO_WISHLIST
  ORDER_PLACED
}

model SubscriptionPayment {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id])
  plan            SubscriptionPlan
  amount          Decimal
  paymentGateway  String // e.g., "Stripe", "Razorpay"
  transactionId   String           @unique
  paidAt          DateTime         @default(now())
  periodStartDate DateTime
  periodEndDate   DateTime

  @@index([businessId])
}

// --- 2. ADVERTISING & SPONSORED PRODUCTS ---

model AdvertisementCampaign {
  id          String         @id @default(uuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id])
  name        String
  budget      Decimal
  spentAmount Decimal        @default(0)
  startDate   DateTime
  endDate     DateTime?
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sponsoredProducts SponsoredProduct[]

  @@index([businessId])
}

model SponsoredProduct {
  id               String                @id @default(uuid())
  campaignId       String
  campaign         AdvertisementCampaign @relation(fields: [campaignId], references: [id])
  productId        String
  product          Product               @relation(fields: [productId], references: [id])
  cpc              Decimal? // Cost-Per-Click
  cpm              Decimal? // Cost-Per-Mille (1000 impressions)
  totalClicks      Int                   @default(0)
  totalImpressions Int                   @default(0)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())

  @@unique([campaignId, productId])
  @@index([productId])
}

// --- 3. CUSTOMER WALLET SYSTEM ---

model CustomerWallet {
  id             String       @id @default(uuid())
  customerUserId String       @unique
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id])
  balance        Decimal      @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String                @id @default(uuid())
  walletId  String
  wallet    CustomerWallet        @relation(fields: [walletId], references: [id])
  amount    Decimal // Can be positive (credit) or negative (debit)
  type      WalletTransactionType
  metadata  Json? // e.g., { "orderId": "...", "reason": "Returned item" }
  createdAt DateTime              @default(now())

  @@index([walletId])
}

// --- 4. USER BEHAVIOR TRACKING ---

model UserInteraction {
  id             BigInt              @id @default(autoincrement())
  customerUserId String?
  customerUser   CustomerUser?       @relation(fields: [customerUserId], references: [id])
  sessionId      String // To group anonymous actions
  eventType      UserInteractionType
  entityId       String? // The ID of the product, category, etc.
  metadata       Json? // e.g., { "searchQuery": "red shoes" }
  timestamp      DateTime            @default(now())

  @@index([customerUserId])
  @@index([eventType])
  @@index([timestamp])
}

// --- 5. SELLER SUPPORT TICKETING SYSTEM ---

model SupportTicket {
  id          String         @id @default(uuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id])
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages SupportTicketMessage[]

  @@index([businessId])
}

model SupportTicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  senderId  String // The ID of the User (seller or admin) who sent it
  sender    User          @relation(fields: [senderId], references: [id])
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model ReturnRequest {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id]) // Connects to the whole Order
  customerUserId String
  reason         String
  status         String // "PENDING_APPROVAL", "APPROVED", etc.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ReturnItem[] // This now links to the join table, not directly to OrderItem
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id])
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])

  quantity Int // The quantity of this specific item being returned

  @@unique([returnRequestId, orderItemId]) // Prevents adding the same item to a return request twice
}

model SellerKycDocument {
  id          String                  @id @default(uuid())
  businessId  String
  type        SellerKycDocumentType
  documentUrl String
  status      SellerKycDocumentStatus @default(PENDING)
  remarks     String?
  uploadedAt  DateTime                @default(now())
  verifiedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model SellerSettlement {
  id         String @id @default(uuid())
  businessId String
  orderId    String // This can be the main Order ID or a specific OrderItem ID if you settle per item

  grossAmount Decimal // Value of the item(s) sold
  commission  Decimal // Platform's commission
  tcsAmount   Decimal // Tax Collected at Source
  netPayable  Decimal // The final amount to be paid to the seller

  status      SettlementStatus @default(PENDING)
  payoutDate  DateTime?
  referenceId String? // Transaction ID from the payout

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@unique([businessId, orderId]) // A seller can only have one settlement per order
  @@index([businessId])
  @@index([orderId])
}

model SellerAgreementLog {
  id         String   @id @default(uuid())
  businessId String
  version    String // e.g., "v2.1 - 2026-01-01"
  acceptedAt DateTime @default(now())
  ipAddress  String?

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model Purchase {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  supplierName    String  @db.VarChar(256)
  supplierGstin   String? @db.VarChar(128)
  supplierAddress String?

  purchaseOrderNo   String // e.g., "PO-1001"
  purchaseOrderDate DateTime
  expectedDate      DateTime?

  totalAmount Decimal
  amountPaid  Decimal @default(0)
  balanceDue  Decimal

  status PurchaseStatus @default(DRAFT)
  notes  String?

  // --- THIS IS THE KEY INVENTORY FLAG ---
  // If true, the items in this purchase will increase the stock count of the variants.
  addToInventory Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      PurchaseItem[]
  debitNotes DebitNote[]

  @@unique([businessId, purchaseOrderNo])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  // Link to the actual product variant in your system
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  itemName String  @db.VarChar(512) // Copied for historical accuracy
  hsnCode  String? @db.VarChar(128)

  quantity      Int // Quantity purchased
  purchasePrice Decimal // Price per unit

  taxRate     Decimal @default(0)
  taxAmount   Decimal @default(0)
  discount    Decimal @default(0)
  totalAmount Decimal // (quantity * purchasePrice) + taxAmount - discount

  createdAt DateTime @default(now())
}

// src/schema.prisma

model Expense {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  expenseDate DateTime
  category    ExpenseCategory @default(OTHER)
  
  // --- GST HEADER DETAILS ---
  vendorName    String? 
  vendorGstin   String?    @db.VarChar(15)  // To match with GSTR-2A
  placeOfSupply String?    @db.VarChar(128) // State Name (Determines IGST vs CGST/SGST)
  invoiceRef    String?    
  isRcmApplicable Boolean  @default(false)  // Reverse Charge Mechanism
  itcClaimed      Boolean  @default(true)   // Is this eligible for Input Tax Credit?

  // --- TOTALS ---
  totalTaxableAmount Decimal @default(0) // Amount before tax
  totalTaxAmount     Decimal @default(0) // Total GST
  totalAmount        Decimal             // Final Amount Paid

  isPaid      Boolean @default(true)
  paymentMode String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    ExpenseItem[]
  deleteAt DateTime?

  @@index([businessId])
}

model ExpenseItem {
  id        String  @id @default(uuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id])

  description String 
  
  // --- GST LINE DETAILS ---
  hsnCode       String?  @db.VarChar(20) // Critical for compliance
  taxableAmount Decimal  // Base Cost
  taxRate       Decimal  @default(0)     // e.g. 5, 12, 18, 28
  
  // Calculated Splits
  cgstAmount    Decimal  @default(0)
  sgstAmount    Decimal  @default(0)
  igstAmount    Decimal  @default(0)
  cessAmount    Decimal  @default(0)

  totalAmount   Decimal  // taxableAmount + taxes

  @@index([expenseId])
}

model BankCashCheque {
  id         String @id @default(uuid())
  businessId String

  accountType AccountType
  accountName String      @db.VarChar(256) // e.g., "HDFC Main", "Cash Drawer"

  // Balances
  openingBalance     Decimal  @default(0)
  openingBalanceDate DateTime @default(now())
  closingBalance     Decimal  @default(0) // This tracks the current money in this account

  // Bank Specific Details (Optional for Cash)
  bankName          String? @db.VarChar(128)
  bankAccountNo     String? @db.VarChar(128)
  bankIfscCode      String? @db.VarChar(128)
  bankAccountHolder String? @db.VarChar(256)
  upiId             String? @db.VarChar(128)

  isDefault Boolean @default(false)
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business         Business                    @relation(fields: [businessId], references: [id])
  transactions     BankCashChequeTransaction[]
  salePaymentModes SalePaymentMode[] // Relation to sales

  @@index([businessId])
}

model BankCashChequeTransaction {
  id         String @id @default(uuid())
  businessId String

  // Link to the Account
  accountId String         @map("bank_cash_cheque_id")
  account   BankCashCheque @relation(fields: [accountId], references: [id])

  // Party Details (Optional)
  partyId   String? // Can link to a Supplier or Customer ID if needed
  partyName String? @db.VarChar(256)

  // Transaction Details
  transactionType TransactionType // CREDIT or DEBIT
  transactionNo   String?         @db.VarChar(128) // e.g., Cheque No, UTR No
  paymentMode     String?         @db.VarChar(128) // "UPI", "NEFT"

  amount         Decimal // The amount moved
  runningBalance Decimal // Balance after this transaction (Snapshot)

  // Linking to Source (Traceability)
  referenceId   String? // ID of the Sale, Purchase, or Expense
  referenceType ReferenceType @default(SALE)
  invoiceNo     String?       @db.VarChar(128)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([accountId])
  @@index([businessId])
}

// --- SALES DOCUMENTS ---

model Quotation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  quotationNo String // e.g., "QT-1001"
  date        DateTime @default(now())
  validUntil  DateTime

  // Party Details (Snapshot)
  partyName      String
  partyPhone     String?
  customerUserId String? // Link to your existing CustomerUser if available

  totalAmount Decimal
  status      QuotationStatus @default(PENDING)

  items QuotationItem[]
   proformaNo   String?   // e.g., "PI-2026-005", Unique per Business if needed
  proformaDate DateTime?

  convertedSaleId String? // If converted to Sale
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
 @@unique([businessId, proformaNo]) 
  @@unique([businessId, quotationNo])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  variantId String? // Link to your existing Variant
  itemName  String
  quantity  Int
  price     Decimal
  taxAmount Decimal
  amount    Decimal
}

model DeliveryChallan {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  challanNo String
  date      DateTime
  partyName String

  // Logic: Items leave inventory, but no invoice is raised yet
  items ChallanItem[]

  status       ChallanStatus @default(OPEN) // OPEN, CONVERTED_TO_INVOICE, RETURNED
  linkedSaleId String? // If converted to Invoice later

  createdAt DateTime @default(now())
}

model ChallanItem {
  id                String          @id @default(uuid())
  deliveryChallanId String
  challan           DeliveryChallan @relation(fields: [deliveryChallanId], references: [id])

  variantId String
  itemName  String
  quantity  Int
}

// --- FINANCIAL ADJUSTMENTS (GST COMPLIANCE) ---

model CreditNote {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  saleId String // Links to your existing Sale model
  sale   Sale   @relation(fields: [saleId], references: [id])

  noteNo String // CN-2024-001
  date   DateTime
  reason String // "Sales Return", "Discount Correction", "Deficiency in Service"

  amount    Decimal // The Value being credited back
  taxAmount Decimal // GST component being reversed

  status String @default("ACTIVE") // ACTIVE, CANCELLED

  createdAt DateTime @default(now())
}

model DebitNote {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  purchaseId String // Links to your existing Purchase model
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  noteNo String // DN-2024-001
  date   DateTime
  reason String

  amount    Decimal
  taxAmount Decimal

  createdAt DateTime @default(now())
}

model Warehouse {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name      String // "Main Shop", "Back Godown"
  address   String?
  isDefault Boolean @default(false)

  stocks          WarehouseStock[]
  sourceTransfers StockTransfer[]  @relation("SourceWarehouse")
  destTransfers   StockTransfer[]  @relation("DestWarehouse")
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  variantId String // Link to your existing Variant
  variant   Variant @relation(fields: [variantId], references: [id])

  quantity Int // Stock in this specific godown

  @@unique([warehouseId, variantId])
}

model StockTransfer {
  id         String   @id @default(uuid())
  businessId String
  date       DateTime @default(now())

  fromWarehouseId String
  fromWarehouse   Warehouse @relation("SourceWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouseId String
  toWarehouse   Warehouse @relation("DestWarehouse", fields: [toWarehouseId], references: [id])

  items  StockTransferItem[]
  status String              @default("COMPLETED")
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id])

  variantId String
  quantity  Int
}

model TaxEntry {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  type    TaxType // TDS_PAYABLE, TDS_RECEIVABLE, TCS_PAYABLE
  section String? // e.g. "194Q", "194C"
  rate    Decimal
  amount  Decimal // The Tax Amount

  referenceId   String // ID of the Sale or Purchase
  referenceType String // "SALE", "PURCHASE"
  partyName     String // Who is the tax against
  panNo         String? // PAN is mandatory for TDS

  isFiled     Boolean   @default(false)
  challanDate DateTime? // When you paid this to govt
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         String @id @default(uuid())
  businessId String
  userId     String // Staff or Owner ID
  action     String // "EDIT_INVOICE", "DELETE_SALE"
  entityName String // "Sale", "Product"
  entityId   String

  oldValue  Json? // What it was before
  newValue  Json? // What it is now
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([entityId])
}

// A unified view for Suppliers (Purchase) and Customers (Sales)
model PartyLedger {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  phoneNo    String? // Optional contact number
  email      String? // Optional email address

  gstin       String? // GSTIN if applicable

  partyType   String // "CUSTOMER" or "SUPPLIER"
  referenceId String? // Link to CustomerUser ID if it exists
  partyName   String // Name for display

  transactionDate DateTime
  description     String // "Inv #101", "Pmt Recd"

  debit  Decimal @default(0) // Receivable increase
  credit Decimal @default(0) // Receivable decrease

  linkedSaleId     String? // Optional link
  linkedPurchaseId String? // Optional link

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([referenceId])
}
model FixedAsset {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])

  name          String   // e.g., "Dell Laptop", "Delivery Scooter"
  purchaseDate  DateTime
  purchasePrice Decimal  // Original Cost (e.g., 50,000)
  
  // This value decreases over time
  currentValue  Decimal  // Book Value (e.g., 40,000)
  
  depreciationRate Decimal @default(10) // e.g., 10% per year
  
  isActive      Boolean  @default(true) // False if sold or scrapped
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId])
}
model ModifierGroup {
  id          String     @id @default(uuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id])
  
  name        String     // e.g., "Pizza Toppings", "Sugar Level"
  minSelection Int       @default(0) // 0 = Optional
  maxSelection Int       @default(1) // 1 = Single Select (Radio), >1 = Multi (Checkbox)

  modifiers   Modifier[]
  products    ProductModifier[] // Many-to-Many: Which products use this group?
}

model Modifier {
  id              String        @id @default(uuid())
  modifierGroupId String
  group           ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  name            String        // "Extra Cheese"
  price           Decimal       @default(0) // Additional cost
  isVegetarian    Boolean       @default(true)
}

// Join Table: Link Products to Modifier Groups
// e.g., "Farmhouse Pizza" uses "Pizza Toppings" group
model ProductModifier {
  productId       String
  modifierGroupId String
  product         Product       @relation(fields: [productId], references: [id])
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@id([productId, modifierGroupId])
}

model KitchenTicket {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id])

  orderId       String    // Link to your main Order/Sale
  // order      Order     @relation(...) 

  kotNumber     Int       // Daily running number (e.g., KOT #5)
  status        KotStatus @default(PENDING)
  
  items         Json      // Snapshot of items in this KOT: [{ name: "Burger", qty: 2, notes: "No onion" }]
  
  createdAt     DateTime  @default(now())
  completedAt   DateTime? 
}
model RestaurantTable {
  id          String      @id @default(uuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id])

  name        String      // "Table 1", "Patio-2"
  zone        String?     // "Indoor", "Outdoor", "Rooftop"
  capacity    Int         @default(4)
  
  status      TableStatus @default(AVAILABLE)
  
  // If occupied, link to the current active order/sale
  activeOrderId String?   @unique 
  // (Note: You might link this to Order or Sale depending on your flow)

  qrCodeUrl   String?     // For "Scan to Order"

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([businessId, name])
}

model ProductWaitlist {
  id String @id @default(uuid())

  // --- Links ---
  businessId     String
  productId      String
  variantId      String?       // Optional: If they want specific size/color
  customerUserId String?       // Optional: If logged in

  // --- Contact Details (For Guests or Overrides) ---
  email          String?
  phone          String?
  
  // --- Configuration ---
  channel        NotificationChannel @default(EMAIL)
  status         WaitlistStatus      @default(PENDING)
  locale         String              @default("en-US") // For email template language

  // --- Metadata ---
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  notifiedAt     DateTime? // When the alert was actually sent

  // --- Relations ---
  business       Business      @relation(fields: [businessId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
  variant        Variant?      @relation(fields: [variantId], references: [id])
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id])

  // --- Indexes for Performance ---
  // Vital: When stock updates, we query by Variant/Product + Status
  @@index([productId, variantId, status]) 
  @@index([businessId])
}

