# ---- Build Stage ----
# Using a specific stable Go version
FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /app

# Copy go.mod and go.sum first to leverage Docker cache
COPY go.mod go.sum ./
RUN go mod download

# Copy the entire source code
COPY . .

# Build the binary
# CGO_ENABLED=0 ensures a static binary that doesn't need external C libraries
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/main .

# ---- Production Stage ----
# Using alpine (instead of scratch) because we need the OS to store SSL/TLS certificates
FROM alpine:latest

# Install CA Certificates so Go can verify SSL connections (e.g., Zoho SMTP)
RUN apk add --no-cache ca-certificates

WORKDIR /app

# Copy the binary from the builder stage
COPY --from=builder /app/main .

# Ensure the executable has permissions
RUN chmod +x /app/main

# Set non-root user for security (Optional but recommended)
RUN adduser -D jottosop
USER jottosop

# Start the application
ENTRYPOINT ["/app/main"]