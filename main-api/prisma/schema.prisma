  sprintId          String?
  sprint            CampaignSprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentId          String?
  parent            CampaignTask?            @relation("SubTasks", fields: [parentId], references: [id], onDelete: SetNull)
  subTasks          CampaignTask[]           @relation("SubTasks")
  title             String                   @db.VarChar(256)
  description       String?
