model ItemBatching {
  id String @id @default(uuid())

  // ── Business Context ──
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // ── Link to Variant ──
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // ── Batch Identity ──
  batchNo String      @db.VarChar(128)
  status  BatchStatus @default(ACTIVE)

  // ── Dates ──
  manufactureDate DateTime?
  expiryDate      DateTime? // NULL = no expiry (non-perishable)

  // ── Stock ──
  openingStock     Decimal  @default(0) // Stock when batch was created
  openingStockDate DateTime @default(now())
  currentStock     Decimal  @default(0) // Live remaining stock in this batch
  reservedStock    Decimal  @default(0) // Reserved for pending orders
  closingStock     Decimal  @default(0) // Snapshot at end of period

  // ── Low Stock Alert ──
  minStockAlert Decimal? // Alert when batch stock < this value

  // ── Pricing (can differ per batch — e.g. imported at different rate) ──
  costPrice         Decimal? // Actual purchase cost for this batch
  sellingPrice      Decimal
  sellingPriceType  String   @db.VarChar(64)
  purchasePrice     Decimal
  purchasePriceType String   @db.VarChar(64)
  mrp               Decimal

  // ── Units ──
  unit                String  @db.VarChar(128)
  isSecondUnitEnabled Boolean @default(false)
  secondUnit          String? @db.VarChar(128)
  conversionRate      Decimal @default(1)

  // ── Source Traceability ──
  purchaseId String? // Which PO created this batch
  supplierId String? // Which supplier

  // ── Location ──
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // ── Notes ──
  notes String? // e.g. "Imported batch, handle carefully"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serialisations ItemSerialisation[]

  @@unique([businessId, variantId, batchNo]) // No duplicate batch nos per product
  @@index([variantId])
  @@index([businessId])
  @@index([expiryDate]) // Critical — used by expiry alert cron job
  @@index([status])
  @@index([purchaseId])
}

model ItemSerialisation {
  id String @id @default(uuid())

  // ── Relations (were ALL missing before) ──
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  batchId String? // Optional — serial may belong to a specific batch
  batch   ItemBatching? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // ── Serial Info ──
  serialNo     String       @db.VarChar(128)
  serialNoDate DateTime     @default(now())
  status       SerialStatus @default(IN_STOCK)

  // ── Sale Link ──
  soldInSaleId String? // Which sale consumed this serial number
  soldAt       DateTime?

  // ── Notes ──
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, serialNo]) // Serial must be unique per business
  @@index([variantId])
  @@index([businessId])
  @@index([batchId])
  @@index([status])
  @@map("item_serialisation")
}

