generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformFeeConfig {
  id String @id @default(uuid())

  feeType PlatformFeeType

  name        String
  description String?

  // Charge structure
  calculationType FeeCalculationType
  rate            Decimal? // % rate if percentage
  amount          Decimal? // fixed charge

  currency String @default("INR")

  // Scope
  appliesToSeller   Boolean @default(true)
  appliesToCustomer Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feeType])
}

enum PlatformFeeType {
  PLATFORM_COMMISSION
  SHIPPING_FEE
  PAYMENT_GATEWAY_FEE
  TDS
  TCS
  PACKAGING_FEE
}

enum FeeCalculationType {
  PERCENTAGE
  FIXED
}

model PlatformCharge {
  id String @id @default(uuid())

  orderId    String
  businessId String

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  chargeType  PlatformChargeType
  description String?

  rate   Decimal?
  amount Decimal

  currency String @default("INR")

  isDeductedFromSeller Boolean @default(true)
  isRefundable         Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([businessId])
}

model CustomerUser {
  id                String                 @id @default(uuid())
  email             String                 @unique
  picture           String?
  name              String
  password          String?
  authSource        AuthSource             @default(self)
  type              CustomerType           @default(user)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  gender            String?
  isActive          Boolean                @default(true)
  isEmailVerified   Boolean                @default(false)
  isPhoneVerified   Boolean                @default(false)
  lastLoginAt       DateTime?
  couponUsages      CouponUsage[]
  phoneNumber       String?                @unique
  preferredLanguage String?                @default("en-US")
  deletedAt         DateTime?
  refreshToken      String?
  addresses         Address[]
  appointments      Appointment[]
  cartItems         CartItem[]
  notifications     CustomerNotification[]
  wallet            CustomerWallet?
  orders            Order[]
  orderInitiates    OrderInitiate[]
  preOrderRequests  PreOrderRequest[]
  productWaitlists  ProductWaitlist[]
  pushSubscriptions PushSubscription[]
  reviews           Review[]
  supportTickets    SupportTicket[]
  supportMessages   SupportTicketMessage[]
  userInteractions  UserInteraction[]
  wishlistItems     Wishlist[]
}

model Wishlist {
  id             String       @id @default(uuid())
  customerUserId String
  productId      String
  createdAt      DateTime     @default(now())
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([customerUserId, productId])
}

model User {
  id                       String                       @id @default(uuid())
  email                    String                       @unique
  password                 String
  role                     String                       @default("user")
  image                    String?
  name                     String?
  createdAt                DateTime                     @default(now())
  preferredLanguage        String?                      @default("en-US")
  identityVerified         Boolean                      @default(false)
  lastKycReviewAt          DateTime?
  refreshToken             String?
  lastOtp                  String? // <--- ADD THIS
  otpExpiry                DateTime? // <--- ADD THIS  
  businesses               Business[]
  businessAccess           BusinessUser[]
  pushSubscriptions        PushSubscription[]
  notifications            SellerNotification[]
  staffProfile             StaffMember?
  supportMessages          SupportTicketMessage[]
  campaigns                Campaign[]
  campaignMembers          CampaignMember[]
  campaignTasks            CampaignTask[]
  campaignTasksCreated     CampaignTask[]               @relation("TaskCreator")
  campaignTaskTimeLogs     CampaignTaskTimeLog[]
  campaignFiles            CampaignFile[]
  campaignChats            CampaignChat[]
  campaignChatReads        CampaignChatRead[]
  campaignDocuments        CampaignDocument[]
  campaignDocumentVersions CampaignDocumentVersion[]
  campaignFolders          CampaignFolder[]
  campaignDocPermissions   CampaignDocumentPermission[]
  campaignDocShareLinks    CampaignDocumentShareLink[]
  performedActivities      ActivityLog[]                @relation("PerformedUserActivities")
  walletTransactions       WalletTransaction[]          @relation("WalletPerformedBy")
}

model Permission {
  id          Int     @id @default(autoincrement())
  action      String
  subject     String
  description String?
  roles       Role[]  @relation("RolePermissions")

  @@unique([action, subject])
}

model Role {
  id            Int            @id @default(autoincrement())
  businessId    String
  name          String
  description   String?
  isDefault     Boolean        @default(false)
  businessUsers BusinessUser[]
  business      Business       @relation(fields: [businessId], references: [id])
  staff         StaffMember[]
  permissions   Permission[]   @relation("RolePermissions")

  @@unique([businessId, name])
}

model BusinessUser {
  id         String    @id @default(uuid())
  userId     String
  businessId String
  roleId     Int
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastOtp    String? // <--- ADD THIS
  otpExpiry  DateTime? // <--- ADD THIS

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

model Address {
  id                     String       @id @default(uuid())
  street                 String
  city                   String
  state                  String
  postalCode             String
  country                String
  customerUserId         String
  alternativePhoneNumber String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  isDefault              Boolean      @default(false)
  landmark               String?
  latitude               Float?
  longitude              Float?
  type                   String       @default("HOME")
  notes                  String?
  customerUser           CustomerUser @relation(fields: [customerUserId], references: [id])
}

model Business {
  id                              String                      @id @default(uuid())
  name                            String
  gstNumber                       String                      @unique
  address                         String
  city                            String
  state                           String
  country                         String
  postalCode                      String
  phone                           String
  ownerId                         String
  email                           String?
  invoicePrefix                   String                      @default("INV")
  purchaseInvoicePrefix           String                      @default("PO")
  invoiceStartNumber              Int                         @default(1)
  purchaseStartNumber             Int                         @default(1)
  fiscalYearStart                 String                      @default("April")
  invoiceNotes                    String?
  invoiceTerms                    String?
  dateFormat                      String                      @default("DD/MM/YYYY")
  language                        String                      @default("en")
  itemBatches                     ItemBatching[]
  serialisations                  ItemSerialisation[]
  campaigns                       Campaign[]
  gstRegistrationType             String?                     @db.VarChar(32)
  isCompositionDealer             Boolean                     @default(false)
  stateCode                       String?                     @db.VarChar(4)
  gstState                        GstState?                   @relation(fields: [stateCode], references: [stateCode])
  isVerified                      Boolean                     @default(false)
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  category                        String                      @default("General")
  bankDetails                     Json?
  bannerUrl                       String?
  description                     String?
  isActive                        Boolean                     @default(true)
  logoUrl                         String?
  rating                          Decimal                     @default(0)
  reviewCount                     Int                         @default(0)
  slug                            String?                     @unique
  socialLinks                     Json?
  websiteUrl                      String?
  plan                            SubscriptionPlan            @default(FREE)
  subscriptionExpiresAt           DateTime?
  stripeCustomerId                String?                     @unique
  businessType                    String                      @default("PROPRIETORSHIP")
  isPayoutEnabled                 Boolean                     @default(false)
  kycRejectedAt                   DateTime?
  kycRemarks                      String?
  kycStatus                       SellerKycStatus             @default(PENDING)
  kycSubmittedAt                  DateTime?
  kycVerifiedAt                   DateTime?
  kycDocumentsJson                Json?                       @map("kyc_documents")
  legalName                       String?
  panNumber                       String?                     @unique
  sellerAgreementAccepted         Boolean                     @default(false)
  sellerAgreementAcceptedAt       DateTime?
  sellerAgreementVersion          String?
  businessConfig                  Json?                       @default("{}")
  currency                        String                      @default("INR")
  industryType                    IndustryType                @default(RETAIL_GENERAL)
  timezone                        String                      @default("Asia/Kolkata")
  authorizedSignatoryDesignation  String?
  authorizedSignatoryName         String?
  authorizedSignatorySignatureUrl String?
  advertisementCampaigns          AdvertisementCampaign[]
  appointments                    Appointment[]
  bankAccounts                    BankCashCheque[]
  ledgerEntries                   BankCashChequeTransaction[]
  owner                           User                        @relation(fields: [ownerId], references: [id])
  authorizedUsers                 BusinessUser[]
  creditNotes                     CreditNote[]
  debitNotes                      DebitNote[]
  challans                        DeliveryChallan[]
  expenses                        Expense[]
  fixedAssets                     FixedAsset[]
  itemUnits                       ItemUnit[]
  kitchenTickets                  KitchenTicket[]
  modifierGroups                  ModifierGroup[]
  partyLedgers                    PartyLedger[]
  preOrderRequests                PreOrderRequest[]
  products                        Product[]
  productWaitlists                ProductWaitlist[]
  purchases                       Purchase[]
  quotations                      Quotation[]
  tables                          RestaurantTable[]
  reviews                         Review[]
  roles                           Role[]
  sales                           Sale[]
  agreementLogs                   SellerAgreementLog[]
  kycDocuments                    SellerKycDocument[]
  settlements                     SellerSettlement[]
  staffMembers                    StaffMember[]
  subscriptionPayments            SubscriptionPayment[]
  supportTickets                  SupportTicket[]
  taxEntries                      TaxEntry[]
  warehouses                      Warehouse[]
  activities                      ActivityLog[]               @relation("BusinessActivities")
  parties                         Party[]
  partyActivities                 PartyActivity[]
  invoiceSeries                   InvoiceSeries[]
  uqcMappings                     UqcMapping[]
  platformCharges                 PlatformCharge[]
}

model InvoiceSeries {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  documentType String @db.VarChar(64)
  // TAX_INVOICE | CREDIT_NOTE | DEBIT_NOTE
  // REVISED_INVOICE | DELIVERY_CHALLAN | RECEIPT_VOUCHER

  prefix String @db.VarChar(32)
  // e.g. "INV", "CN", "DN"

  fromNo         Int
  toNo           Int
  totalIssued    Int @default(0)
  totalCancelled Int @default(0)

  periodMonth Int // 1–12
  periodYear  Int // e.g. 2025

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([periodMonth, periodYear])
  @@map("invoice_series")
}

model UqcMapping {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customUnit String @db.VarChar(64)
  // What the seller types: "piece", "pcs", "pc", "nos"

  gstUqc String @db.VarChar(16)
  // Standard GST code: NOS, KGS, MTR, LTR, SQM, TON, NA

  @@unique([businessId, customUnit])
  @@index([businessId])
  @@map("uqc_mapping")
}

model GstState {
  id        Int    @id @default(autoincrement())
  stateCode String @unique @db.VarChar(4)
  // "01", "02", ... "37"

  stateName String @unique @db.VarChar(128)
  // "Jammu and Kashmir", "Kerala" etc.

  stateShortName String @db.VarChar(8)
  // "JK", "KL", "MH", "TN" etc.

  isUT        Boolean      @default(false)
  // true for Union Territories like Ladakh, DD, DNH
  sales       Sale[]
  creditNotes CreditNote[]
  businesses  Business[]
  parties     Party[]

  @@map("gst_state")
}

model Appointment {
  id             String            @id @default(uuid())
  businessId     String
  customerUserId String?
  customerName   String?
  customerPhone  String?
  staffId        String?
  serviceId      String
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  business       Business          @relation(fields: [businessId], references: [id])
  customerUser   CustomerUser?     @relation(fields: [customerUserId], references: [id])
  service        Product           @relation(fields: [serviceId], references: [id])
  staff          StaffMember?      @relation(fields: [staffId], references: [id])

  @@index([businessId])
  @@index([staffId])
  @@index([startTime])
}

model SellerNotification {
  id        String           @id @default(uuid())
  title     String
  message   String
  isRead    Boolean          @default(false)
  type      NotificationType @default(ORDER)
  metadata  Json?
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerNotification {
  id             String           @id @default(uuid())
  title          String
  message        String
  isRead         Boolean          @default(false)
  type           NotificationType @default(ORDER)
  metadata       Json?
  customerUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customerUser   CustomerUser     @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
}

model Category {
  id              Int         @id @default(autoincrement())
  name            String      @db.VarChar(255)
  slug            String      @unique
  parentId        Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  commissionRate  Decimal?
  description     String?
  gstRate         Decimal     @default(0)
  imageUrl        String?
  isActive        Boolean     @default(true)
  metaDescription String?
  metaTitle       String?
  position        Int         @default(0)
  attributes      Attribute[]
  products        Product[]
  parent          Category?   @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        Category[]  @relation("SubCategories")

  @@map("category")
}

model Product {
  id                  String                   @id @default(uuid())
  title               String
  description         String?
  isCustomizable      Boolean                  @default(false)
  images              String[]
  isPublished         Boolean                  @default(false)
  isFeatured          Boolean                  @default(false)
  slug                String                   @unique
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  businessId          String
  categoryId          Int
  publishDate         DateTime?
  customizationConfig Json?
  model3dUrl          String?
  isArable            Boolean                  @default(false)
  searchVector        Unsupported("tsvector")? @map("search_vector")
  licenseDocumentUrl  String?                  @map("license_document_url")
  brand               String?
  metaDescription     String?
  metaTitle           String?
  tags                String[]
  deletedAt           DateTime?
  productType         ProductType              @default(STANDARD)
  appointments        Appointment[]
  recipe              BillOfMaterial?
  preOrderRequests    PreOrderRequest[]
  business            Business                 @relation(fields: [businessId], references: [id])
  category            Category                 @relation(fields: [categoryId], references: [id])
  modifierGroups      ProductModifier[]
  productWaitlists    ProductWaitlist[]
  reviews             Review[]
  sponsorships        SponsoredProduct[]
  variants            Variant[]
  wishlistItems       Wishlist[]

  @@index([title])
  @@index([searchVector], map: "product_search_idx", type: Gin)
  @@index([tags], map: "product_tags_array_idx", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "product_title_trgm_idx", type: Gin)
}

model Variant {
  id                     String        @id @default(uuid())
  sku                    String        @unique
  price                  Decimal       @db.Decimal(10, 2)
  stock                  Int
  isDefault              Boolean       @default(false)
  weightInGrams          Int?
  images                 String[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  hsnCode                String?
  sacCode                String?
  mrp                    Decimal?      @db.Decimal(10, 2)
  purchasePrice          Decimal?      @db.Decimal(10, 2)
  purchasePriceType      String?       @db.VarChar(64)
  tax                    String?       @db.VarChar(128)
  minStockCount          Decimal?      @db.Decimal(10, 2)
  isMinStockAlertEnabled Boolean?
  productId              String
  status                 VariantStatus @default(DRAFT)
  description            String?
  dimensionUnit          String?       @default("CM")
  height                 Decimal?
  length                 Decimal?
  width                  Decimal?

  // ── NEW: Batching & Expiry Control ──
  isBatchingEnabled Boolean @default(false) // Does this variant use batch tracking?
  isExpiryTracked   Boolean @default(false) // Should expiry dates be tracked?
  isSerialTracked   Boolean @default(false) // Serial number tracking?

  // ── NEW: Expiry Alert Config ──
  expiryAlertDays Int? // Alert X days before expiry (e.g. 30)

  // ── NEW: Stock Deduction Method ──
  stockDeductionMethod StockMethod @default(FIFO) // FIFO / FEFO / MANUAL

  // ── Existing Relations ──
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems        CartItem[]
  orderItems       OrderItem[]
  stockActivities  StockActivity[]
  attributeValues  VariantAttributeValue[]
  purchaseItems    PurchaseItem[]
  warehouseStocks  WarehouseStock[]
  productWaitlists ProductWaitlist[]
  bomItems         BomItem[]
  preOrderRequests PreOrderRequest[]
  deletedAt        DateTime?

  // ── New Relations ──
  batches        ItemBatching[]
  serialisations ItemSerialisation[]

  @@index([productId])
}

model Attribute {
  id            Int                     @id @default(autoincrement())
  name          String
  categoryId    Int
  position      Int                     @default(0)
  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options       AttributeOption[]
  variantValues VariantAttributeValue[]

  @@unique([name, categoryId])
}

model AttributeOption {
  id            Int                     @id @default(autoincrement())
  value         String
  attributeId   Int
  position      Int                     @default(0)
  slug          String
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_option")
}

model VariantAttributeValue {
  id                Int             @id @default(autoincrement())
  variantId         String
  attributeOptionId Int
  attributeId       Int
  attribute         Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeOption   AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Cascade)
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_attribute_value")
}

model BillOfMaterial {
  id        String    @id @default(uuid())
  productId String    @unique
  product   Product   @relation(fields: [productId], references: [id])
  items     BomItem[]
}

model BomItem {
  id               String         @id @default(uuid())
  billOfMaterialId String
  variantId        String
  quantity         Decimal
  billOfMaterial   BillOfMaterial @relation(fields: [billOfMaterialId], references: [id])
  variant          Variant        @relation(fields: [variantId], references: [id])
}

model Review {
  id                 String       @id @default(uuid())
  rating             Int
  comment            String?
  productId          String
  createdAt          DateTime     @default(now())
  businessId         String
  customerUserId     String
  images             String[]
  isVerifiedPurchase Boolean      @default(false)
  repliedAt          DateTime?
  reply              String?
  status             String       @default("APPROVED")
  title              String?
  business           Business     @relation(fields: [businessId], references: [id])
  customerUser       CustomerUser @relation(fields: [customerUserId], references: [id])
  product            Product      @relation(fields: [productId], references: [id])
}

model Order {
  id                    String        @id @default(uuid())
  totalAmount           Decimal
  customerUserId        String
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(pending)
  status                OrderStatus   @default(pending)
  selectedAddress       Json
  discount              Decimal       @default(0)
  taxAmount             Decimal       @default(0)
  shippingFee           Decimal       @default(0)
  trackingNumber        String?
  estimatedDeliveryDate DateTime?
  cancellationReason    String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  cancelledAt           DateTime?
  confirmedAt           DateTime?
  currency              String        @default("INR")
  deliveredAt           DateTime?
  ipAddress             String?
  isRefunded            Boolean       @default(false)
  orderNumber           String        @unique
  refundAmount          Decimal?
  shippedAt             DateTime?
  couponId              String?
  couponCode            String?       @db.VarChar(128)
  couponDiscount        Decimal?      @db.Decimal(10, 2)

  coupon          Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  customerUser    CustomerUser       @relation(fields: [customerUserId], references: [id])
  items           OrderItem[]
  returnRequests  ReturnRequest[]
  platformCharges PlatformCharge[]
  settlements     SellerSettlement[]
  supportTickets  SupportTicket[]
}

model CouponUsage {
  id String @id @default(uuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  customerUserId String
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  orderId String? @unique
  // unique = one usage record per order

  discountApplied Decimal   @db.Decimal(10, 2)
  usedAt          DateTime  @default(now())
  isReversed      Boolean   @default(false)
  reversedAt      DateTime?
  // composite index for perUserLimit check query

  @@index([couponId])
  @@index([customerUserId])
  @@index([couponId, customerUserId])
}

model OrderItem {
  id                   String       @id @default(uuid())
  quantity             Int
  priceAtTimeOfOrder   Decimal
  note                 String?
  orderId              String
  productId            String
  variantId            String?
  customizationDetails Json?
  customizationImages  String[]
  order                Order        @relation(fields: [orderId], references: [id])
  variant              Variant?     @relation(fields: [variantId], references: [id])
  returnedIn           ReturnItem[]
}

model CartItem {
  id                   String       @id @default(uuid())
  quantity             Int
  productId            String
  variantId            String?
  customerUserId       String
  customizationDetails Json?
  customizationImages  String[]     @default([])
  customerUser         CustomerUser @relation(fields: [customerUserId], references: [id])
  variant              Variant?     @relation(fields: [variantId], references: [id])
}

model OrderInitiate {
  id             String              @id @default(uuid())
  orderId        String              @map("order_id")
  status         OrderInitiateStatus @default(pending)
  customerUserId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  details        Json?
  customerUser   CustomerUser        @relation(fields: [customerUserId], references: [id])
}

model Discount {
  id                String           @id @default(uuid())
  name              String
  description       String?
  discountType      DiscountType     @map("discount_type")
  discountValue     Decimal          @map("discount_value")
  startDate         DateTime?        @map("start_date")
  endDate           DateTime?        @map("end_date")
  minOrderAmount    Decimal?         @map("min_order_amount")
  maxDiscountAmount Decimal?         @map("max_discount_amount")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  coupons           Coupon[]
  targets           DiscountTarget[]
}

model DiscountTarget {
  id         String     @id @default(uuid())
  brand      String?    @db.VarChar(256)
  discountId String     @map("discount_id")
  targetType TargetType @map("target_type")
  productId  String?    @map("product_id")
  categoryId Int?       @map("category_id")
  discount   Discount   @relation(fields: [discountId], references: [id])
}

model Coupon {
  id              String        @id @default(uuid())
  code            String        @unique
  active          Boolean       @default(true)
  discountId      String        @map("discount_id")
  maxUses         Int?          @map("max_uses")
  usedCount       Int           @default(0) @map("used_count")
  perUserLimit    Int?          @map("per_user_limit")
  firstOrderOnly  Boolean       @default(false)
  maxOrderAmount  Decimal?      @db.Decimal(10, 2)
  minItemQuantity Int?
  channel         String?       @db.VarChar(64)
  usages          CouponUsage[]
  orders          Order[]
  startsAt        DateTime?     @map("starts_at")
  expiresAt       DateTime?     @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  discount        Discount      @relation(fields: [discountId], references: [id])
}

model PushSubscription {
  id             String        @id @default(uuid())
  endpoint       String        @unique
  p256dh         String
  auth           String
  customerUserId String?
  userId         String?
  createdAt      DateTime      @default(now())
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([customerUserId])
  @@index([userId])
}

model PromotionalBanner {
  id             Int      @id @default(autoincrement())
  title          String
