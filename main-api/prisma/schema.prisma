  uploadedByUserId  String?
  uploadedByStaffId String?
  defaultAccess     DocumentAccess               @default(VIEW_ONLY)
  isPublic          Boolean                      @default(false)
  tags              String[]                     @default([])
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  deletedAt         DateTime?
  permissions       CampaignDocumentPermission[]
  shareLinks        CampaignDocumentShareLink[]
  versions          CampaignDocumentVersion[]
  campaign          Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  folder            CampaignFolder?              @relation(fields: [folderId], references: [id])
  uploadedByStaff   StaffMember?                 @relation(fields: [uploadedByStaffId], references: [id])
  uploadedByUser    User?                        @relation(fields: [uploadedByUserId], references: [id])

  @@index([campaignId])
  @@index([folderId])
  @@map("campaign_documents")
}

model CampaignDocumentVersion {
  id                String           @id @default(uuid())
  documentId        String
  versionNumber     Int
  url               String
  sizeBytes         Int
  changeNote        String?
  uploadedByUserId  String?
  uploadedByStaffId String?
  createdAt         DateTime         @default(now())
  document          CampaignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedByStaff   StaffMember?     @relation(fields: [uploadedByStaffId], references: [id])
  uploadedByUser    User?            @relation(fields: [uploadedByUserId], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("campaign_document_versions")
}

model CampaignFolder {
  id              String             @id @default(uuid())
  campaignId      String
  parentId        String?
  name            String             @db.VarChar(128)
  color           String?
  position        Int                @default(0)
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  documents       CampaignDocument[]
  campaign        Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdByUser   User?              @relation(fields: [createdByUserId], references: [id])
  parent          CampaignFolder?    @relation("FolderChildren", fields: [parentId], references: [id])
  children        CampaignFolder[]   @relation("FolderChildren")

  @@unique([campaignId, parentId, name])
  @@index([campaignId])
  @@index([parentId])
  @@map("campaign_folders")
}

model CampaignDocumentPermission {
  id              String           @id @default(uuid())
  documentId      String
  userId          String?
  staffId         String?
  access          DocumentAccess
  grantedByUserId String?
  grantedAt       DateTime         @default(now())
  document        CampaignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  staff           StaffMember?     @relation(fields: [staffId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@unique([documentId, staffId])
  @@index([documentId])
  @@map("campaign_document_permissions")
}

model CampaignDocumentShareLink {
  id               String                      @id @default(uuid())
  documentId       String
  token            String                      @unique @default(uuid())
  access           DocumentAccess              @default(VIEW_ONLY)
  status           ShareLinkStatus             @default(ACTIVE)
  expiresAt        DateTime?
  maxViews         Int?
  viewCount        Int                         @default(0)
  passwordHash     String?
  createdByUserId  String?
  createdByStaffId String?
  createdAt        DateTime                    @default(now())
  accessLogs       CampaignDocumentAccessLog[]
  createdByStaff   StaffMember?                @relation(fields: [createdByStaffId], references: [id])
  createdByUser    User?                       @relation(fields: [createdByUserId], references: [id])
  document         CampaignDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([documentId])
  @@index([expiresAt])
  @@map("campaign_document_share_links")
}

model CampaignDocumentAccessLog {
  id          String                    @id @default(uuid())
  shareLinkId String
  userId      String?
  staffId     String?
  ipAddress   String?                   @db.VarChar(45)
  userAgent   String?
  accessedAt  DateTime                  @default(now())
  shareLink   CampaignDocumentShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
  @@index([accessedAt])
  @@map("campaign_document_access_logs")
}

model GstFilingSnapshot {
  id                   String              @id @default(uuid())
  filingRequestId      String              @unique
  outwardSupplies      Json
  inwardSupplies       Json?
  hsnSummary           Json?
  documentSummary      Json?
  itcFromPurchases     Decimal             @default(0)
  itcFromImport        Decimal             @default(0)
  itcReversed          Decimal             @default(0)
  ineligibleItc        Decimal             @default(0)
  totalInvoiceCount    Int                 @default(0)
  totalCreditNoteCount Int                 @default(0)
  snapshotTakenAt      DateTime            @default(now())
  lineItems            GstFilingLineItem[]
  filingRequest        GstFilingRequest    @relation(fields: [filingRequestId], references: [id])

  @@map("gst_filing_snapshots")
}

model GstFilingLineItem {
  id              String            @id @default(uuid())
  snapshotId      String
  sourceType      String            @db.VarChar(32)
  sourceId        String
  invoiceNo       String            @db.VarChar(128)
  invoiceDate     DateTime
  partyName       String            @db.VarChar(256)
  partyGstin      String?           @db.VarChar(15)
  placeOfSupply   String            @db.VarChar(128)
  invoiceCategory String            @db.VarChar(8)
  taxableAmount   Decimal
  cgst            Decimal           @default(0)
  sgst            Decimal           @default(0)
  igst            Decimal           @default(0)
  cess            Decimal           @default(0)
  totalAmount     Decimal
  isReverseCharge Boolean           @default(false)
  snapshot        GstFilingSnapshot @relation(fields: [snapshotId], references: [id])

  @@index([snapshotId])
  @@index([sourceType, sourceId])
  @@map("gst_filing_line_items")
}

model GstTaxPaymentChallan {
  filingRequestId String               @unique
  challanNo       String?              @db.VarChar(64)
  challanDate     DateTime?
  bankReference   String?              @db.VarChar(128)
  id              String               @id @default(uuid())
  businessId      String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  cgstAmount      Decimal              @default(0)
  sgstAmount      Decimal              @default(0)
  igstAmount      Decimal              @default(0)
  cessAmount      Decimal              @default(0)
  lateFee         Decimal              @default(0)
  interest        Decimal              @default(0)
  totalAmount     Decimal
  status          ChallanPaymentStatus @default(PENDING)
  challanPdfUrl   String?
  business        Business             @relation(fields: [businessId], references: [id])
  filingRequest   GstFilingRequest     @relation(fields: [filingRequestId], references: [id])

  @@index([businessId])
  @@map("gst_tax_payment_challans")
}

model GstFilingDocument {
  id                  String           @id @default(uuid())
  createdAt           DateTime         @default(now())
  filingRequestId     String
  documentType        String           @db.VarChar(64)
  fileName            String           @db.VarChar(256)
  fileUrl             String
  isVisibleToBusiness Boolean          @default(true)
  uploadedByUserId    String?
  filingRequest       GstFilingRequest @relation(fields: [filingRequestId], references: [id])
  uploadedByUser      User?            @relation(fields: [uploadedByUserId], references: [id])

  @@index([filingRequestId])
  @@map("gst_filing_documents")
}

model GstFilingAuditLog {
  id                String           @id @default(uuid())
  filingRequestId   String
  createdAt         DateTime         @default(now())
  action            String           @db.VarChar(128)
  fromStatus        GstFilingStatus?
  toStatus          GstFilingStatus?
  performedByUserId String?
  note              String?
  metadata          Json?
  filingRequest     GstFilingRequest @relation(fields: [filingRequestId], references: [id])

  @@index([performedByUserId])
  @@index([filingRequestId])
  @@map("gst_filing_audit_logs")
}

