  // ── Lifetime Stats (for analytics & loyalty dashboard) ──
  lifetimeEarned Decimal @default(0) // Total ever credited (all time)
  lifetimeSpent  Decimal @default(0) // Total ever debited (all time)

  // ── Limits ──
  maxBalance Decimal @default(10000) // Cap to prevent abuse (configurable)

  // ── Admin Controls ──
  isLocked     Boolean   @default(false) // Admin can freeze wallet
  lockedReason String? // Why it was frozen
  lockedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("customer_wallets")
}

model WalletTransaction {
  id BigInt @id @default(autoincrement())

  // ── Link to Wallet ──
  walletId String
  wallet   CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // ── Transaction Core ──
  amount    Decimal // Always POSITIVE number
  direction WalletDirection // CREDIT or DEBIT — never use negative amounts
  type      WalletTransactionType
  status    WalletTxStatus        @default(SUCCESS)

  // ── Balance Snapshot (critical for statement view) ──
  balanceBefore Decimal // Balance before this transaction
  balanceAfter  Decimal // Balance after this transaction

  // ── Traceability (link back to order/refund/etc.) ──
  referenceId   String? // orderId, refundId, campaignId etc.
  referenceType String? // "ORDER", "REFUND", "MANUAL", "REFERRAL"

  // ── Display ──
  description String? // "Cashback for Order #INV-0023"
  note        String? // Admin internal note (not shown to user)

  // ── Expiry (for promotional credits only) ──
  expiresAt DateTime? // NULL = never expires
  isExpired Boolean   @default(false)

  // ── Who did this (for manual adjustments) ──
  performedByUserId String? // Admin/staff userId who triggered this

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  performedByUser User?    @relation("WalletPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([referenceId])
  @@index([status])
  @@index([expiresAt]) // For expiry cron job
  @@index([createdAt]) // For date range queries on statements
  @@map("wallet_transactions")
}

