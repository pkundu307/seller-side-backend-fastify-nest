generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformFeeConfig {
  id                String             @id @default(uuid())
  feeType           PlatformFeeType    @unique
  name              String
  description       String?
  calculationType   FeeCalculationType
  rate              Decimal?
  amount            Decimal?
  currency          String             @default("INR")
  appliesToSeller   Boolean            @default(true)
  appliesToCustomer Boolean            @default(false)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PlatformCharge {
  id                   String             @id @default(uuid())
  orderId              String
  businessId           String
  chargeType           PlatformChargeType
  description          String?
  rate                 Decimal?
  amount               Decimal
  currency             String             @default("INR")
  isDeductedFromSeller Boolean            @default(true)
  isRefundable         Boolean            @default(false)
  createdAt            DateTime           @default(now())
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([businessId])
}

model CustomerUser {
  id                String                 @id @default(uuid())
  email             String                 @unique
  picture           String?
  name              String
  password          String?
  authSource        AuthSource             @default(self)
  type              CustomerType           @default(user)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  gender            String?
  isActive          Boolean                @default(true)
  isEmailVerified   Boolean                @default(false)
  isPhoneVerified   Boolean                @default(false)
  lastLoginAt       DateTime?
  phoneNumber       String?                @unique
  preferredLanguage String?                @default("en-US")
  deletedAt         DateTime?
  refreshToken      String?
  addresses         Address[]
  appointments      Appointment[]
  cartItems         CartItem[]
  couponUsages      CouponUsage[]
  notifications     CustomerNotification[]
  orders            Order[]
  orderInitiates    OrderInitiate[]
  preOrderRequests  PreOrderRequest[]
  productWaitlists  ProductWaitlist[]
  pushSubscriptions PushSubscription[]
  reviews           Review[]
  supportTickets    SupportTicket[]
  supportMessages   SupportTicketMessage[]
  userInteractions  UserInteraction[]
  wishlistItems     Wishlist[]
  wallet            CustomerWallet?
}

model Wishlist {
  id             String       @id @default(uuid())
  customerUserId String
  productId      String
  createdAt      DateTime     @default(now())
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([customerUserId, productId])
}

model User {
  id                       String                       @id @default(uuid())
  email                    String                       @unique
  password                 String
  role                     String                       @default("user")
  image                    String?
  name                     String?
  createdAt                DateTime                     @default(now())
  preferredLanguage        String?                      @default("en-US")
  identityVerified         Boolean                      @default(false)
  lastKycReviewAt          DateTime?
  refreshToken             String?
  lastOtp                  String?
  otpExpiry                DateTime?
  businesses               Business[]
  businessAccess           BusinessUser[]
  pushSubscriptions        PushSubscription[]
  sales                    Sale[]
  notifications            SellerNotification[]
  staffProfile             StaffMember?
  supportMessages          SupportTicketMessage[]
  performedActivities      ActivityLog[]                @relation("PerformedUserActivities")
  campaignChatReads        CampaignChatRead[]
  campaignChats            CampaignChat[]
  campaignDocPermissions   CampaignDocumentPermission[]
  campaignDocShareLinks    CampaignDocumentShareLink[]
  campaignDocumentVersions CampaignDocumentVersion[]
  campaignDocuments        CampaignDocument[]
  campaignFiles            CampaignFile[]
  campaignFolders          CampaignFolder[]
  campaignMembers          CampaignMember[]
  campaignTaskTimeLogs     CampaignTaskTimeLog[]
  campaignTasks            CampaignTask[]
  campaignTasksCreated     CampaignTask[]               @relation("TaskCreator")
  campaigns                Campaign[]
  gstFilingDocuments       GstFilingDocument[]
  walletTransactions       WalletTransaction[]          @relation("WalletPerformedBy")
}

model Permission {
  id          Int     @id @default(autoincrement())
  action      String
  subject     String
  description String?
  roles       Role[]  @relation("RolePermissions")

  @@unique([action, subject])
}

model Role {
  id            Int            @id @default(autoincrement())
  businessId    String
  name          String
  description   String?
  isDefault     Boolean        @default(false)
  businessUsers BusinessUser[]
  business      Business       @relation(fields: [businessId], references: [id])
  staff         StaffMember[]
  permissions   Permission[]   @relation("RolePermissions")

  @@unique([businessId, name])
}

model BusinessUser {
  id         String    @id @default(uuid())
  userId     String
  businessId String
  roleId     Int
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastOtp    String?
  otpExpiry  DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

model Address {
  id                     String       @id @default(uuid())
  street                 String
  city                   String
  state                  String
  postalCode             String
  country                String
  customerUserId         String
  alternativePhoneNumber String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  isDefault              Boolean      @default(false)
  landmark               String?
  latitude               Float?
  longitude              Float?
  type                   String       @default("HOME")
  notes                  String?
  stateCode              String?      @db.VarChar(4)
  customerUser           CustomerUser @relation(fields: [customerUserId], references: [id])
}

model Business {
  id                              String                      @id @default(uuid())
  name                            String
  gstNumber                       String?                     @unique
  address                         String
  city                            String
  state                           String
  country                         String
  postalCode                      String
  phone                           String
  ownerId                         String
  email                           String?
  invoicePrefix                   String                      @default("INV")
  purchaseInvoicePrefix           String                      @default("PO")
  invoiceStartNumber              Int                         @default(1)
  purchaseStartNumber             Int                         @default(1)
  fiscalYearStart                 String                      @default("April")
  invoiceNotes                    String?
  invoiceTerms                    String?
  dateFormat                      String                      @default("DD/MM/YYYY")
  language                        String                      @default("en")
  isVerified                      Boolean                     @default(false)
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  category                        String                      @default("General")
  bankDetails                     Json?
  bannerUrl                       String?
  description                     String?
  isActive                        Boolean                     @default(true)
  logoUrl                         String?
  rating                          Decimal                     @default(0)
  reviewCount                     Int                         @default(0)
  slug                            String?                     @unique
  socialLinks                     Json?
  websiteUrl                      String?
  plan                            SubscriptionPlan            @default(FREE)
  subscriptionExpiresAt           DateTime?
  stripeCustomerId                String?                     @unique
  businessType                    String                      @default("PROPRIETORSHIP")
  isPayoutEnabled                 Boolean                     @default(false)
  kycRejectedAt                   DateTime?
  kycRemarks                      String?
  kycStatus                       SellerKycStatus             @default(PENDING)
  kycSubmittedAt                  DateTime?
  kycVerifiedAt                   DateTime?
  kycDocumentsJson                Json?                       @map("kyc_documents")
  legalName                       String?
  panNumber                       String?                     @unique
  sellerAgreementAccepted         Boolean                     @default(false)
  sellerAgreementAcceptedAt       DateTime?
  sellerAgreementVersion          String?
  businessConfig                  Json?                       @default("{}")
  currency                        String                      @default("INR")
  industryType                    IndustryType                @default(RETAIL_GENERAL)
  timezone                        String                      @default("Asia/Kolkata")
  authorizedSignatoryDesignation  String?
  authorizedSignatoryName         String?
  authorizedSignatorySignatureUrl String?
  gstRegistrationType             String?                     @db.VarChar(32)
  isCompositionDealer             Boolean                     @default(false)
  stateCode                       String?                     @db.VarChar(4)
  gstFilingConsentAt              DateTime?
  gstFilingConsentIp              String?
  gstPortalPasswordEnc            String?
  gstPortalUsername               String?
  isGstFilingEnabled              Boolean                     @default(false)
  advertisementCampaigns          AdvertisementCampaign[]
  appointments                    Appointment[]
  bankAccounts                    BankCashCheque[]
  ledgerEntries                   BankCashChequeTransaction[]
  owner                           User                        @relation(fields: [ownerId], references: [id])
  gstState                        GstState?                   @relation(fields: [stateCode], references: [stateCode])
  authorizedUsers                 BusinessUser[]
  creditNotes                     CreditNote[]
  debitNotes                      DebitNote[]
  challans                        DeliveryChallan[]
  expenses                        Expense[]
  fixedAssets                     FixedAsset[]
  itemBatches                     ItemBatching[]
  itemUnits                       ItemUnit[]
  kitchenTickets                  KitchenTicket[]
  modifierGroups                  ModifierGroup[]
  parties                         Party[]
  partyActivities                 PartyActivity[]
  partyLedgers                    PartyLedger[]
  platformCharges                 PlatformCharge[]
  preOrderRequests                PreOrderRequest[]
  products                        Product[]
  productWaitlists                ProductWaitlist[]
  purchases                       Purchase[]
  quotations                      Quotation[]
  tables                          RestaurantTable[]
  reviews                         Review[]
  roles                           Role[]
  sales                           Sale[]
  agreementLogs                   SellerAgreementLog[]
  kycDocuments                    SellerKycDocument[]
  settlements                     SellerSettlement[]
  staffMembers                    StaffMember[]
  subscriptionPayments            SubscriptionPayment[]
  supportTickets                  SupportTicket[]
  taxEntries                      TaxEntry[]
  warehouses                      Warehouse[]
  activities                      ActivityLog[]               @relation("BusinessActivities")
  campaigns                       Campaign[]
  gstFilingRequests               GstFilingRequest[]
  gstTaxPaymentChallans           GstTaxPaymentChallan[]
  invoiceSeries                   InvoiceSeries[]
  serialisations                  ItemSerialisation[]
  otherIncomes                    OtherIncome[]
  salesDebitNotes                 SalesDebitNote[]            @relation("BusinessSalesDebitNotes")
  uqcMappings                     UqcMapping[]
}

model GstFilingRequest {
  id                  String                @id @default(uuid())
  businessId          String
  returnType          GstReturnType
  periodMonth         Int
  periodYear          Int
  frequency           GstFilingFrequency    @default(MONTHLY)
  dueDate             DateTime?
  status              GstFilingStatus       @default(DRAFT)
  assignedToUserId    String?
  assignedAt          DateTime?
  sentForReviewAt     DateTime?
  approvedAt          DateTime?
  reviewedByUserId    String?
  approvalNotes       String?
  filedAt             DateTime?
  ackNumber           String?               @db.VarChar(64)
  ackDate             DateTime?
  arnNumber           String?               @db.VarChar(128)
  totalOutwardTaxable Decimal?
  totalOutwardTax     Decimal?
  totalItcClaimed     Decimal?
  netTaxPayable       Decimal?
  lateFee             Decimal?              @default(0)
  interest            Decimal?              @default(0)
  failureReason       String?
  portalErrorCode     String?               @db.VarChar(64)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  auditLogs           GstFilingAuditLog[]
  documents           GstFilingDocument[]
  business            Business              @relation(fields: [businessId], references: [id])
  snapshot            GstFilingSnapshot?
  challan             GstTaxPaymentChallan?

  @@unique([businessId, returnType, periodMonth, periodYear])
  @@index([businessId])
  @@index([status])
  @@index([returnType, periodMonth, periodYear])
  @@map("gst_filing_requests")
}

model InvoiceSeries {
  id             String   @id @default(uuid())
  businessId     String
  documentType   String   @db.VarChar(64)
  prefix         String   @db.VarChar(32)
  fromNo         Int
  toNo           Int
  totalIssued    Int      @default(0)
  totalCancelled Int      @default(0)
  periodMonth    Int
  periodYear     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([periodMonth, periodYear])
  @@map("invoice_series")
}

model UqcMapping {
  id         String   @id @default(uuid())
  businessId String
  customUnit String   @db.VarChar(64)
  gstUqc     String   @db.VarChar(16)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, customUnit])
  @@index([businessId])
  @@map("uqc_mapping")
}

model GstState {
  id             Int          @id @default(autoincrement())
  stateCode      String       @unique @db.VarChar(4)
  stateName      String       @unique @db.VarChar(128)
  stateShortName String       @db.VarChar(8)
  isUT           Boolean      @default(false)
  businesses     Business[]
  creditNotes    CreditNote[]
  parties        Party[]
  sales          Sale[]

  @@map("gst_state")
}

model Appointment {
  id             String            @id @default(uuid())
  businessId     String
  customerUserId String?
  customerName   String?
  customerPhone  String?
  staffId        String?
  serviceId      String
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  business       Business          @relation(fields: [businessId], references: [id])
  customerUser   CustomerUser?     @relation(fields: [customerUserId], references: [id])
  service        Product           @relation(fields: [serviceId], references: [id])
  staff          StaffMember?      @relation(fields: [staffId], references: [id])

  @@index([businessId])
  @@index([staffId])
  @@index([startTime])
}

model SellerNotification {
  id        String           @id @default(uuid())
  title     String
  message   String
  isRead    Boolean          @default(false)
  type      NotificationType @default(ORDER)
  metadata  Json?
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerNotification {
  id             String           @id @default(uuid())
  title          String
  message        String
  isRead         Boolean          @default(false)
  type           NotificationType @default(ORDER)
  metadata       Json?
  customerUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customerUser   CustomerUser     @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
}

model Category {
  id              Int         @id @default(autoincrement())
  name            String      @db.VarChar(255)
  slug            String      @unique
  parentId        Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  commissionRate  Decimal?
  description     String?
  gstRate         Decimal     @default(0)
  imageUrl        String?
  isActive        Boolean     @default(true)
  metaDescription String?
  metaTitle       String?
  position        Int         @default(0)
  attributes      Attribute[]
  products        Product[]
  parent          Category?   @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        Category[]  @relation("SubCategories")
  layouts         CategoryLayout[]
  @@map("category")
}

model Product {
  id                  String                   @id @default(uuid())
  title               String
  description         String?
  isCustomizable      Boolean                  @default(false)
  images              String[]
  isPublished         Boolean                  @default(false)
  isFeatured          Boolean                  @default(false)
  slug                String                   @unique
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  businessId          String
  categoryId          Int
  publishDate         DateTime?
  customizationConfig Json?
  model3dUrl          String?
  isArable            Boolean                  @default(false)
  searchVector        Unsupported("tsvector")? @map("search_vector")
  licenseDocumentUrl  String?                  @map("license_document_url")
  brand               String?
  metaDescription     String?
  metaTitle           String?
  tags                String[]
  deletedAt           DateTime?
  productType         ProductType              @default(STANDARD)
  appointments        Appointment[]
  recipe              BillOfMaterial?
  preOrderRequests    PreOrderRequest[]
  business            Business                 @relation(fields: [businessId], references: [id])
  category            Category                 @relation(fields: [categoryId], references: [id])
  modifierGroups      ProductModifier[]
  productWaitlists    ProductWaitlist[]
  reviews             Review[]
  sponsorships        SponsoredProduct[]
  variants            Variant[]
  wishlistItems       Wishlist[]

  @@index([title])
  @@index([searchVector], map: "product_search_idx", type: Gin)
  @@index([tags], map: "product_tags_array_idx", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "product_title_trgm_idx", type: Gin)
}

model Variant {
  id                     String                  @id @default(uuid())
  sku                    String                  @unique
  price                  Decimal                 @db.Decimal(10, 2)
  stock                  Int
  isDefault              Boolean                 @default(false)
  weightInGrams          Int?
  images                 String[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  hsnCode                String?
  sacCode                String?
  mrp                    Decimal?                @db.Decimal(10, 2)
  purchasePrice          Decimal?                @db.Decimal(10, 2)
  purchasePriceType      String?                 @db.VarChar(64)
  tax                    String?                 @db.VarChar(128)
  minStockCount          Decimal?                @db.Decimal(10, 2)
  isMinStockAlertEnabled Boolean?
  productId              String
  status                 VariantStatus           @default(DRAFT)
  description            String?
  dimensionUnit          String?                 @default("CM")
  height                 Decimal?
  length                 Decimal?
  width                  Decimal?
  isBatchingEnabled      Boolean                 @default(false)
  isExpiryTracked        Boolean                 @default(false)
  isSerialTracked        Boolean                 @default(false)
  expiryAlertDays        Int?
  stockDeductionMethod   StockMethod             @default(FIFO)
  deletedAt              DateTime?
  bomItems               BomItem[]
  cartItems              CartItem[]
  batches                ItemBatching[]
  orderItems             OrderItem[]
  preOrderRequests       PreOrderRequest[]
  productWaitlists       ProductWaitlist[]
  purchaseItems          PurchaseItem[]
  stockActivities        StockActivity[]
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseStocks        WarehouseStock[]
  serialisations         ItemSerialisation[]
  attributeValues        VariantAttributeValue[]

  @@index([productId])
}

model Attribute {
  id            Int                     @id @default(autoincrement())
  name          String
  categoryId    Int
  position      Int                     @default(0)
  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options       AttributeOption[]
  variantValues VariantAttributeValue[]

  @@unique([name, categoryId])
}

model AttributeOption {
  id            Int                     @id @default(autoincrement())
  value         String
  attributeId   Int
  position      Int                     @default(0)
  slug          String
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_option")
}

model VariantAttributeValue {
  id                Int             @id @default(autoincrement())
  variantId         String
  attributeOptionId Int
  attributeId       Int
  attribute         Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeOption   AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Cascade)
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_attribute_value")
}

model BillOfMaterial {
  id        String    @id @default(uuid())
  productId String    @unique
  product   Product   @relation(fields: [productId], references: [id])
  items     BomItem[]
}

model BomItem {
  id               String         @id @default(uuid())
  billOfMaterialId String
  variantId        String
  quantity         Decimal
  billOfMaterial   BillOfMaterial @relation(fields: [billOfMaterialId], references: [id])
  variant          Variant        @relation(fields: [variantId], references: [id])
}

model Review {
  id                 String       @id @default(uuid())
  rating             Int
  comment            String?
  productId          String
  createdAt          DateTime     @default(now())
  businessId         String
  customerUserId     String
  images             String[]
  isVerifiedPurchase Boolean      @default(false)
  repliedAt          DateTime?
  reply              String?
  status             String       @default("APPROVED")
  title              String?
  business           Business     @relation(fields: [businessId], references: [id])
  customerUser       CustomerUser @relation(fields: [customerUserId], references: [id])
  product            Product      @relation(fields: [productId], references: [id])
}

model OtherIncome {
  id          String   @id @default(uuid())
  businessId  String
  date        DateTime
  description String   @db.VarChar(256)
  amount      Decimal
  category    String?  @db.VarChar(128)
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("other_income")
}

model Order {
  id                    String             @id @default(uuid())
  totalAmount           Decimal
  customerUserId        String
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus      @default(pending)
  status                OrderStatus        @default(pending)
  selectedAddress       Json
  discount              Decimal            @default(0)
  taxAmount             Decimal            @default(0)
  shippingFee           Decimal            @default(0)
  trackingNumber        String?
  estimatedDeliveryDate DateTime?
  cancellationReason    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  cancelledAt           DateTime?
  confirmedAt           DateTime?
  currency              String             @default("INR")
  deliveredAt           DateTime?
  ipAddress             String?
  isRefunded            Boolean            @default(false)
  orderNumber           String             @unique
  refundAmount          Decimal?
  shippedAt             DateTime?
  couponCode            String?            @db.VarChar(128)
  couponDiscount        Decimal?           @db.Decimal(10, 2)
  couponId              String?
  coupon                Coupon?            @relation(fields: [couponId], references: [id])
  customerUser          CustomerUser       @relation(fields: [customerUserId], references: [id])
  items                 OrderItem[]
  platformCharges       PlatformCharge[]
  returnRequests        ReturnRequest[]
  settlements           SellerSettlement[]
  supportTickets        SupportTicket[]
}

model CouponUsage {
  id              String       @id @default(uuid())
  couponId        String
  customerUserId  String
  orderId         String?      @unique
  discountApplied Decimal      @db.Decimal(10, 2)
  usedAt          DateTime     @default(now())
  isReversed      Boolean      @default(false)
  reversedAt      DateTime?
  coupon          Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerUser    CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerUserId])
  @@index([couponId, customerUserId])
}

model OrderItem {
  id                   String       @id @default(uuid())
  quantity             Int
  priceAtTimeOfOrder   Decimal
  note                 String?
  orderId              String
  productId            String
  variantId            String?
  customizationDetails Json?
  customizationImages  String[]
  businessId           String?
  supplyState          String?
  supplyStateCode      String?      @db.VarChar(4)
  order                Order        @relation(fields: [orderId], references: [id])
  variant              Variant?     @relation(fields: [variantId], references: [id])
  returnedIn           ReturnItem[]
}

model CartItem {
  id                   String       @id @default(uuid())
  quantity             Int
  productId            String
  variantId            String?
  customerUserId       String
  customizationDetails Json?
  customizationImages  String[]     @default([])
  supplyState          String?
  supplyStateCode      String?      @db.VarChar(4)
  customerUser         CustomerUser @relation(fields: [customerUserId], references: [id])
  variant              Variant?     @relation(fields: [variantId], references: [id])
}

model OrderInitiate {
  id             String              @id @default(uuid())
  orderId        String              @map("order_id")
  status         OrderInitiateStatus @default(pending)
  customerUserId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  details        Json?
  customerUser   CustomerUser        @relation(fields: [customerUserId], references: [id])
}

model Discount {
  id                String           @id @default(uuid())
  name              String
  description       String?
  discountType      DiscountType     @map("discount_type")
  discountValue     Decimal          @map("discount_value")
  startDate         DateTime?        @map("start_date")
  endDate           DateTime?        @map("end_date")
  minOrderAmount    Decimal?         @map("min_order_amount")
  maxDiscountAmount Decimal?         @map("max_discount_amount")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  coupons           Coupon[]
  targets           DiscountTarget[]
}

model DiscountTarget {
  id         String     @id @default(uuid())
  discountId String     @map("discount_id")
  targetType TargetType @map("target_type")
  productId  String?    @map("product_id")
  categoryId Int?       @map("category_id")
  brand      String?    @db.VarChar(256)
  discount   Discount   @relation(fields: [discountId], references: [id])
}

model Coupon {
  id              String        @id @default(uuid())
  code            String        @unique
