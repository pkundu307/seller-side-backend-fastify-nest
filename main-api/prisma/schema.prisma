model Party {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  partyType     String    @db.VarChar(128) // SUPPLIER / CUSTOMER / BOTH
  partyCategory String?   @db.VarChar(128)
  partyName     String    @db.VarChar(256)
  stateCode     String?   @db.VarChar(4)
  gstState      GstState? @relation(fields: [stateCode], references: [stateCode])
  isBusiness    Boolean   @default(true)
  businessName  String?   @db.VarChar(512)
  email         String?   @db.VarChar(128)
  phoneNo       String?   @db.VarChar(36)
  phoneNoAlt    String?   @db.VarChar(36)

  taxId                 String? @db.VarChar(128) // GSTIN
  panNo                 String? @db.VarChar(128)
  tanNo                 String? @db.VarChar(128)
  placeOfSupply         String? @db.VarChar(128)
  billingAddress        Json? // structured address
  shippingAddress       Json?
  isBillingShippingSame Boolean @default(true)

  openingBalance     Decimal?  @db.Decimal(18, 2)
  openingBalanceType String?   @db.VarChar(36) // TO_PAY / TO_COLLECT
  openingBalanceDate DateTime?

  creditPeriod Int?
  creditLimit  Decimal? @db.Decimal(18, 2)

  closingBalance Decimal? @db.Decimal(18, 2)

  notes       String?
  customField Json? // for your custom fields

  isEnabled Boolean @default(true)
  isSynced  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  activities       PartyActivity[]
  ledgerEntries    PartyLedger[]               @relation("PartyLedgerParty")
  bankTransactions BankCashChequeTransaction[] @relation("PartyBankTx")
  sales            Sale[]                      @relation("SaleParty")
  purchases        Purchase[]                  @relation("PurchaseParty")

  @@index([businessId, partyType])
}

